<Window x:Class="ASPAssistant.App.Windows.SidePanelWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:ASPAssistant.App.Views"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="ASP Assistant"
        Width="310" MinWidth="280" MaxWidth="400"
        WindowStyle="None"
        ResizeMode="CanResizeWithGrip"
        ShowInTaskbar="True"
        Topmost="True"
        Icon="{StaticResource AspaLogo}"
        Background="{StaticResource PanelBackgroundBrush}">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="5" GlassFrameThickness="0" />
    </WindowChrome.WindowChrome>
    <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
        <DockPanel>
            <!-- Custom title bar -->
            <Border DockPanel.Dock="Top" Background="#FF12122A" MouseLeftButtonDown="OnTitleBarDrag">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <Button x:Name="SettingsButton" Content="⚙" FontFamily="Segoe UI Symbol"
                                Click="OnOpenSettings" ToolTip="设置" AutomationProperties.Name="设置"
                                Style="{StaticResource TitleBarButton}" />
                        <Button Content="─" Click="OnMinimize"
                                Style="{StaticResource TitleBarButton}" />
                        <Button Content="✕" Click="OnClose"
                                Style="{StaticResource CloseButton}" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Image Source="{StaticResource AspaLogo}" Width="16" Height="16" Margin="10,0,0,0" />
                        <TextBlock Text="ASP Assistant" Foreground="{StaticResource TextPrimaryBrush}"
                                   FontSize="12" VerticalAlignment="Center" Margin="8,0,0,0" />
                    </StackPanel>
                </DockPanel>
            </Border>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="SidebarColumn" Width="0" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border x:Name="SideFilterPanel" Grid.Column="0" Visibility="Collapsed"
                        Background="#FF202039" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0">
                    <DockPanel Margin="8">
                        <DockPanel DockPanel.Dock="Top" Margin="0,5,0,12">
                            <Button x:Name="CollapseSideFiltersButton" DockPanel.Dock="Left" Content="› 收起" Click="OnCollapseSideFilters"
                                    Style="{StaticResource TrackingButton}" Margin="0,0,6,0" Padding="5,3" />
                            <Button x:Name="ResetSideFiltersButton" DockPanel.Dock="Right" Content="重置"
                                    Click="OnResetSideFilters" Style="{StaticResource TrackingButton}" Margin="5,0,0,0" Padding="5,3" />
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="筛选" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" />
                                <TextBlock x:Name="SideFilterCount" Foreground="{StaticResource AccentBrush}" FontSize="13" Margin="6,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </DockPanel>
                        <ScrollViewer x:Name="SideFilterTagScroll" DockPanel.Dock="Top" MaxHeight="90" Margin="0,0,0,6"
                                      Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <ContentControl x:Name="SideFilterTags" />
                        </ScrollViewer>
                        <ContentControl x:Name="SideFilterActions" DockPanel.Dock="Bottom" />
                        <ScrollViewer x:Name="SideFilterScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" />
                    </DockPanel>
                </Border>
                <Border x:Name="FilterRail" Grid.Column="0" Visibility="Collapsed" Background="{StaticResource PanelBackgroundBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0">
                    <Button x:Name="ExpandSideFiltersButton" Click="OnExpandSideFilters" VerticalAlignment="Stretch" VerticalContentAlignment="Top"
                            Style="{StaticResource TrackingButton}" Padding="2,12" BorderThickness="0" ToolTip="展开筛选">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{StaticResource PanelBackgroundBrush}" Padding="{TemplateBinding Padding}">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Top" />
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                        <StackPanel>
                            <TextBlock Text="‹" FontSize="22" HorizontalAlignment="Center" />
                            <TextBlock Text="筛" FontSize="11" HorizontalAlignment="Center" Margin="0,4,0,0" />
                            <TextBlock Text="选" FontSize="11" HorizontalAlignment="Center" />
                            <TextBlock x:Name="FilterRailCount" Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Center" Margin="0,6,0,0" />
                        </StackPanel>
                    </Button>
                </Border>
                <Grid x:Name="MainSurface" Grid.Column="1">
            <Grid x:Name="MainContent">
                <DockPanel>
                    <!-- Update notification banner (hidden until a new version is found) -->
                    <Border x:Name="UpdateBanner" DockPanel.Dock="Top"
                            Background="#1A2D4A1E"
                            BorderBrush="#FF2D4A1E" BorderThickness="0,0,0,1"
                            Visibility="Collapsed" Padding="10,5">
                        <DockPanel>
                            <Button x:Name="UpdateActionButton" DockPanel.Dock="Right"
                                    Click="OnShowUpdateDialog"
                                    Padding="8,3" FontSize="11" Cursor="Hand"
                                    BorderThickness="0" Background="#FF4CAF50" Foreground="White">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="bg" Background="{TemplateBinding Background}"
                                                CornerRadius="4" Padding="{TemplateBinding Padding}">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="bg" Property="Background" Value="#FF66BB6A" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="↑ " FontWeight="Bold" />
                                    <TextBlock Text="查看更新" />
                                </StackPanel>
                            </Button>
                            <TextBlock x:Name="UpdateBannerText"
                                       Foreground="#FF8BC34A" FontSize="11"
                                       VerticalAlignment="Center" />
                        </DockPanel>
                    </Border>
                    <Border DockPanel.Dock="Top" Padding="10,6" Background="#FF182736">
                        <TextBlock x:Name="PreparationStatusText" Text="自动 BP 检测已开启，等待准备界面"
                                   Foreground="#FF8CDDE5" FontSize="11" TextWrapping="Wrap" />
                    </Border>
                    <TabControl x:Name="MainTabs" Style="{StaticResource DarkTabControl}">
                        <TabItem Header="干员">
                            <views:OperatorBrowseView x:Name="OperatorView" />
                        </TabItem>
                        <TabItem Header="装备">
                            <views:EquipmentBrowseView x:Name="EquipmentView" />
                        </TabItem>
                        <TabItem Header="追踪">
                            <views:TrackingView x:Name="TrackingView" />
                        </TabItem>
                        <TabItem x:Name="LineupTab" Header="阵容">
                            <views:LineupView x:Name="LineupView" />
                        </TabItem>
                    </TabControl>
                </DockPanel>
                <Border x:Name="PreparationOverlay" Background="#FF172C3A"
                        BorderBrush="#FF64CAD6" BorderThickness="2" Visibility="Collapsed">
                    <ScrollViewer VerticalAlignment="Center" VerticalScrollBarVisibility="Auto" Padding="20">
                        <StackPanel>
                            <TextBlock Text="自动 BP" FontSize="15" FontWeight="Bold"
                                       Foreground="#FF8CDDE5" />
                            <TextBlock x:Name="PreparationOverlayTitle" Margin="0,10,0,14"
                                       Foreground="White" FontSize="24" FontWeight="Bold" TextWrapping="Wrap" />
                            <TextBlock x:Name="PreparationOverlayText" Foreground="#FFE4F7FA"
                                       FontSize="17" TextWrapping="Wrap" />
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </Grid>
            <DockPanel x:Name="SettingsPage" Visibility="Collapsed" Margin="12">
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,14">
                    <Button x:Name="BackFromSettingsButton" Content="返回" DockPanel.Dock="Right" Click="OnCloseSettings"
                            Style="{StaticResource TrackingButton}" Padding="8,4" />
                    <TextBlock Text="设置" FontSize="18" FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" />
                </DockPanel>
                <Border DockPanel.Dock="Bottom" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="0,10,0,0">
                    <StackPanel>
                        <TextBlock x:Name="SettingsUpdateStatus" Foreground="{StaticResource TextSecondaryBrush}"
                                   TextWrapping="Wrap" Margin="0,0,0,6" />
                        <Button x:Name="SettingsViewUpdateButton" Content="查看更新" Click="OnShowUpdateDialog"
                                Style="{StaticResource TrackingButton}" HorizontalAlignment="Right" Visibility="Collapsed" Margin="0,0,0,6" />
                        <DockPanel>
                            <Button x:Name="SettingsCheckUpdateButton" Content="检查更新" DockPanel.Dock="Right"
                                    Click="OnCheckForUpdates" Style="{StaticResource TrackingButton}" Padding="8,5" />
                            <TextBlock x:Name="SettingsVersion" Foreground="{StaticResource TextPrimaryBrush}"
                                       FontSize="12" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,6,0" />
                        </DockPanel>
                    </StackPanel>
                </Border>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <Border Background="{StaticResource CardBackgroundBrush}" BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1" CornerRadius="7" Padding="10">
                            <StackPanel>
                                <TextBlock Text="筛选布局" FontSize="14" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,9" />
                                <CheckBox x:Name="LayoutToggle" Content="在侧边显示筛选"
                                          Foreground="{StaticResource TextPrimaryBrush}" />
                                <TextBlock Text="开启时，干员和装备筛选显示在侧边。关闭后，筛选回到列表顶部。"
                                           Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,6,0,0" />
                            </StackPanel>
                        </Border>
                        <Border x:Name="SettingsLineupAccountCard" Background="{StaticResource CardBackgroundBrush}"
                                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="7" Padding="10"
                                Margin="0,10,0,0" Visibility="Collapsed">
                            <StackPanel>
                                <TextBlock Text="卫戍阵容库" FontSize="14" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,6" />
                                <TextBlock x:Name="SettingsLineupAccountStatus" Foreground="{StaticResource TextSecondaryBrush}"
                                           TextWrapping="Wrap" Margin="0,0,0,8" />
                                <Button x:Name="SettingsLineupAccountButton" Click="OnSettingsLineupAccount"
                                        Style="{StaticResource TrackingButton}" HorizontalAlignment="Left" Padding="8,5" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
                </Grid>
            </Grid>
        </DockPanel>
    </Border>
</Window>
