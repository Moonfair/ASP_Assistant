<Window x:Class="ASPAssistant.App.Windows.SidePanelWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:ASPAssistant.App.Views"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="ASP Assistant"
        Width="310" MinWidth="280" MaxWidth="400"
        WindowStyle="None"
        ResizeMode="CanResizeWithGrip"
        ShowInTaskbar="True"
        Topmost="True"
        Icon="{StaticResource AspaLogo}"
        Background="{StaticResource PanelBackgroundBrush}">
    <Window.Resources>
        <Style x:Key="PanelPage" TargetType="TabItem" BasedOn="{StaticResource {x:Type TabItem}}">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
        </Style>
        <!-- Only the main panel uses overflow; detail and editor tabs retain their own layouts. -->
        <ControlTemplate x:Key="PanelNavigation" TargetType="TabControl">
            <DockPanel>
                <Border DockPanel.Dock="Top" Background="#FF151B2B" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
                    <Grid KeyboardNavigation.TabNavigation="Continue">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="3*" /><ColumnDefinition /></Grid.ColumnDefinitions>
                        <UniformGrid x:Name="HeaderPanel" IsItemsHost="True" Rows="1"
                                     KeyboardNavigation.DirectionalNavigation="Cycle" />
                        <Button x:Name="MorePagesButton" Grid.Column="1" Click="OnMorePages" Padding="4,6"
                                ToolTip="更多页面" AutomationProperties.Name="{Binding Content, RelativeSource={RelativeSource Self}, StringFormat='更多页面：{0}'}">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource TitleBarButton}">
                                    <Setter Property="Content" Value="更多" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedItem.Visibility, RelativeSource={RelativeSource AncestorType=TabControl}}" Value="Collapsed">
                                            <Setter Property="Content" Value="{Binding SelectedItem.Header, RelativeSource={RelativeSource AncestorType=TabControl}}" />
                                            <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <Button.ContentTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding}" VerticalAlignment="Center" />
                                        <Path Data="M 0,0 L 3,3 L 6,0" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                              StrokeThickness="1.4" VerticalAlignment="Center" Margin="5,2,0,0" />
                                    </StackPanel>
                                </DataTemplate>
                            </Button.ContentTemplate>
                        </Button>
                        <Border x:Name="MoreSelectedLine" Grid.Column="1" Height="2" VerticalAlignment="Bottom"
                                Background="{StaticResource AccentBrush}" IsHitTestVisible="False">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedItem.Visibility, RelativeSource={RelativeSource AncestorType=TabControl}}" Value="Collapsed">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                        </Border>
                    </Grid>
                </Border>
                <Border Background="{StaticResource PanelBackgroundBrush}">
                    <ContentPresenter x:Name="PART_SelectedContentHost" ContentSource="SelectedContent" />
                </Border>
            </DockPanel>
        </ControlTemplate>
    </Window.Resources>
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="5" GlassFrameThickness="0" />
    </WindowChrome.WindowChrome>
    <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
        <DockPanel>
            <!-- Custom title bar -->
            <Border DockPanel.Dock="Top" Background="#FF12122A" MouseLeftButtonDown="OnTitleBarDrag">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Image Source="{StaticResource AspaLogo}" Width="16" Height="16" Margin="10,0,0,0" />
                        <TextBlock Text="ASP Assistant" Foreground="{StaticResource TextPrimaryBrush}"
                                   FontSize="12" VerticalAlignment="Center" Margin="8,0,0,0" />
                    </StackPanel>
                    <Button x:Name="GameSourceButton" Grid.Column="1" Click="OnSelectGameSource"
                            Style="{StaticResource TrackingButton}" Padding="5,2" Margin="4,0"
                            HorizontalAlignment="Right" VerticalAlignment="Center"
                            ToolTip="{Binding Text, ElementName=GameSourceStatus}" AutomationProperties.Name="选择游戏来源">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Right" Text="▾" Margin="4,0,0,0" VerticalAlignment="Center" />
                            <TextBlock x:Name="GameSourceStatus" Text="游戏来源" TextTrimming="CharacterEllipsis"
                                       VerticalAlignment="Center" />
                        </DockPanel>
                    </Button>
                    <StackPanel Grid.Column="2" Orientation="Horizontal">
                        <Button x:Name="SettingsButton" Content="⚙" FontFamily="Segoe UI Symbol"
                                Click="OnOpenSettings" ToolTip="设置" AutomationProperties.Name="设置"
                                Style="{StaticResource TitleBarButton}" />
                        <Button Content="─" Click="OnMinimize" ToolTip="最小化" AutomationProperties.Name="最小化"
                                Style="{StaticResource TitleBarButton}" />
                        <Button Content="✕" Click="OnClose" ToolTip="关闭" AutomationProperties.Name="关闭"
                                Style="{StaticResource CloseButton}" />
                    </StackPanel>
                </Grid>
            </Border>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="SidebarColumn" Width="0" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition x:Name="RightSidebarColumn" Width="0" />
                </Grid.ColumnDefinitions>
                <Border x:Name="SideFilterPanel" Grid.Column="0" Panel.ZIndex="1" Visibility="Collapsed"
                        Background="#FF202039" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0">
                    <Border.Resources>
                        <Style x:Key="FilterShortcutButton" TargetType="Button" BasedOn="{StaticResource TrackingButton}">
                            <Setter Property="Padding" Value="5,2" />
                            <Setter Property="Margin" Value="0,2,4,2" />
                            <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
                        </Style>
                    </Border.Resources>
                    <DockPanel Margin="8">
                        <DockPanel DockPanel.Dock="Top" Margin="0,5,0,12">
                            <Button x:Name="CollapseSideFiltersButton" DockPanel.Dock="Left" Content="› 收起" Click="OnCollapseSideFilters"
                                    Style="{StaticResource TrackingButton}" Margin="0,0,6,0" Padding="5,3" />
                            <Button x:Name="ResetSideFiltersButton" DockPanel.Dock="Right" Content="重置"
                                    Click="OnResetSideFilters" Style="{StaticResource TrackingButton}" Margin="5,0,0,0" Padding="5,3" />
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="筛选" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" />
                                <TextBlock x:Name="SideFilterCount" Foreground="{StaticResource AccentBrush}" FontSize="13" Margin="6,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </DockPanel>
                        <ScrollViewer x:Name="SideFilterTagScroll" DockPanel.Dock="Top" MaxHeight="90" Margin="0,0,0,6"
                                      Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <ContentControl x:Name="SideFilterTags" />
                        </ScrollViewer>
                        <ContentControl x:Name="SideFilterActions" DockPanel.Dock="Bottom" />
                        <WrapPanel x:Name="TopFilterShortcuts" DockPanel.Dock="Top" />
                        <WrapPanel x:Name="BottomFilterShortcuts" DockPanel.Dock="Bottom" />
                        <ScrollViewer x:Name="SideFilterScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" />
                    </DockPanel>
                </Border>
                <Border x:Name="FilterRail" Grid.Column="0" Visibility="Collapsed" Background="{StaticResource PanelBackgroundBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0">
                    <Button x:Name="ExpandSideFiltersButton" Click="OnExpandSideFilters" VerticalAlignment="Stretch" VerticalContentAlignment="Top"
                            Style="{StaticResource TrackingButton}" Padding="2,12" BorderThickness="0" ToolTip="展开筛选">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{StaticResource PanelBackgroundBrush}" Padding="{TemplateBinding Padding}">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Top" />
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                        <StackPanel>
                            <TextBlock x:Name="ExpandSideFiltersArrow" Text="‹" FontSize="22" HorizontalAlignment="Center" />
                            <TextBlock Text="筛" FontSize="11" HorizontalAlignment="Center" Margin="0,4,0,0" />
                            <TextBlock Text="选" FontSize="11" HorizontalAlignment="Center" />
                            <TextBlock x:Name="FilterRailCount" Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Center" Margin="0,6,0,0" />
                        </StackPanel>
                    </Button>
                </Border>
                <Grid x:Name="MainSurface" Grid.Column="1">
            <Grid x:Name="MainContent">
                <DockPanel>
                    <!-- Update notification banner (hidden until a new version is found) -->
                    <Border x:Name="UpdateBanner" DockPanel.Dock="Top"
                            Background="#1A2D4A1E"
                            BorderBrush="#FF2D4A1E" BorderThickness="0,0,0,1"
                            Visibility="Collapsed" Padding="10,5">
                        <DockPanel>
                            <Button x:Name="UpdateActionButton" DockPanel.Dock="Right"
                                    Click="OnShowUpdateDialog"
                                    Padding="8,3" FontSize="11" Cursor="Hand"
                                    BorderThickness="0" Background="#FF4CAF50" Foreground="White">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="bg" Background="{TemplateBinding Background}"
                                                CornerRadius="4" Padding="{TemplateBinding Padding}">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="bg" Property="Background" Value="#FF66BB6A" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="↑ " FontWeight="Bold" />
                                    <TextBlock Text="查看更新" />
                                </StackPanel>
                            </Button>
                            <TextBlock x:Name="UpdateBannerText"
                                       Foreground="#FF8BC34A" FontSize="11"
                                       VerticalAlignment="Center" />
                        </DockPanel>
                    </Border>
                    <Border DockPanel.Dock="Top" Padding="10,6" Background="#FF182736">
                        <TextBlock x:Name="PreparationStatusText" Text="自动 BP 检测已开启，等待准备界面"
                                   Foreground="#FF8CDDE5" FontSize="11" TextWrapping="Wrap" />
                    </Border>
                    <Border x:Name="MatchStatusBar" DockPanel.Dock="Top" Padding="8,5"
                            Background="#FF182736" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0"
                            DataContext="{Binding GameStateVm, RelativeSource={RelativeSource AncestorType=Window}}">
                        <DockPanel>
                            <Border x:Name="CannotPortrait" DockPanel.Dock="Left" Width="30" Height="30"
                                    Margin="0,0,6,0" Padding="1" VerticalAlignment="Center"
                                    Background="#FF10242A" BorderBrush="#FF65C6BE"
                                    BorderThickness="1" CornerRadius="5" ToolTip="坎诺特">
                                <Grid><Image Source="{StaticResource AspaLogo}" Width="18" Height="18" Opacity="0.65" />
                                    <Image x:Name="CannotPortraitImage" Stretch="UniformToFill"
                                       AutomationProperties.Name="坎诺特" /></Grid>
                            </Border>
                            <UniformGrid Rows="1" MinHeight="32">
                                <UniformGrid.Resources>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="FontSize" Value="11" />
                                        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
                                    </Style>
                                    <Style x:Key="HudValue" TargetType="Run">
                                        <Setter Property="FontSize" Value="14" />
                                        <Setter Property="FontWeight" Value="SemiBold" />
                                        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
                                    </Style>
                                </UniformGrid.Resources>
                                <StackPanel VerticalAlignment="Center" Margin="4,0">
                                    <TextBlock><Run Text="回合 " /><Run Style="{StaticResource HudValue}" Text="{Binding Hud.Round, Mode=OneWay, TargetNullValue=—, FallbackValue=—}" /></TextBlock>
                                </StackPanel>
                                <StackPanel VerticalAlignment="Center" Margin="4,0">
                                    <TextBlock><Run Text="商店等级 " /><Run Style="{StaticResource HudValue}" Text="{Binding Hud.ShopLevel, Mode=OneWay, TargetNullValue=—, FallbackValue=—}" /></TextBlock>
                                    <TextBlock Margin="0,1,0,0" FontSize="10"><Run Text="升级费用 " /><Run Text="{Binding Hud.UpgradeCost, Mode=OneWay, TargetNullValue=—, FallbackValue=—}" /></TextBlock>
                                </StackPanel>
                                <StackPanel VerticalAlignment="Center" Margin="4,0">
                                    <TextBlock><Run Text="金币 " /><Run Style="{StaticResource HudValue}" Text="{Binding Hud.Gold, Mode=OneWay, TargetNullValue=—, FallbackValue=—}" /></TextBlock>
                                    <TextBlock Margin="0,1,0,0" FontSize="10"><Run Text="下回合 " /><Run Text="{Binding Hud.NextRoundGold, Mode=OneWay, TargetNullValue=—, FallbackValue=—}" /></TextBlock>
                                </StackPanel>
                            </UniformGrid>
                        </DockPanel>
                    </Border>
                    <TabControl x:Name="MainTabs" Style="{StaticResource DarkTabControl}" Template="{StaticResource PanelNavigation}"
                                ItemContainerStyle="{StaticResource PanelPage}">
                        <TabItem x:Name="OperatorTab" Header="干员">
                            <views:OperatorBrowseView x:Name="OperatorView" />
                        </TabItem>
                        <TabItem x:Name="EquipmentTab" Header="装备">
                            <views:EquipmentBrowseView x:Name="EquipmentView" />
                        </TabItem>
                        <TabItem Header="追踪">
                            <views:TrackingView x:Name="TrackingView" />
                        </TabItem>
                        <TabItem Visibility="Collapsed" Header="敌人">
                            <views:EnemyView x:Name="EnemyView" />
                        </TabItem>
                        <TabItem x:Name="LineupTab" Visibility="Collapsed" Header="阵容">
                            <views:LineupView x:Name="LineupView" />
                        </TabItem>
                        <TabItem x:Name="MatchTab" Visibility="Collapsed" Header="匹配" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
                            <views:MatchView x:Name="MatchView" />
                        </TabItem>
                        <TabItem Visibility="Collapsed" Header="数据" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
                            <views:BattleDataView x:Name="BattleData" />
                        </TabItem>
                        <TabItem Visibility="Collapsed" Header="调试" FontSize="11" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
                            <views:GarrisonDebugView x:Name="GarrisonDebug" />
                        </TabItem>
                    </TabControl>
                </DockPanel>
                <Border x:Name="PreparationOverlay" Background="#FF172C3A"
                        BorderBrush="#FF64CAD6" BorderThickness="2" Visibility="Collapsed">
                    <ScrollViewer VerticalAlignment="Center" VerticalScrollBarVisibility="Auto" Padding="20">
                        <StackPanel>
                            <TextBlock Text="自动 BP" FontSize="15" FontWeight="Bold"
                                       Foreground="#FF8CDDE5" />
                            <TextBlock x:Name="PreparationOverlayTitle" Margin="0,10,0,14"
                                       Foreground="White" FontSize="24" FontWeight="Bold" TextWrapping="Wrap" />
                            <TextBlock x:Name="PreparationOverlayText" Foreground="#FFE4F7FA"
                                       FontSize="17" TextWrapping="Wrap" />
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </Grid>
            <DockPanel x:Name="SettingsPage" Visibility="Collapsed" Margin="12">
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,14">
                    <Button x:Name="BackFromSettingsButton" Content="返回" DockPanel.Dock="Right" Click="OnCloseSettings"
                            Style="{StaticResource TrackingButton}" Padding="8,4" />
                    <TextBlock Text="设置" FontSize="18" FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" />
                </DockPanel>
                <Border DockPanel.Dock="Bottom" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="0,10,0,0">
                    <StackPanel>
                        <TextBlock x:Name="SettingsUpdateStatus" Foreground="{StaticResource TextSecondaryBrush}"
                                   TextWrapping="Wrap" Margin="0,0,0,6" />
                        <Button x:Name="SettingsViewUpdateButton" Content="查看更新" Click="OnShowUpdateDialog"
                                Style="{StaticResource TrackingButton}" HorizontalAlignment="Right" Visibility="Collapsed" Margin="0,0,0,6" />
                        <DockPanel>
                            <Button x:Name="SettingsCheckUpdateButton" Content="检查更新" DockPanel.Dock="Right"
                                    Click="OnCheckForUpdates" Style="{StaticResource TrackingButton}" Padding="8,5" />
                            <TextBlock x:Name="SettingsVersion" Foreground="{StaticResource TextPrimaryBrush}"
                                       FontSize="12" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,6,0" />
                        </DockPanel>
                    </StackPanel>
                </Border>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <Border Background="{StaticResource CardBackgroundBrush}" BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1" CornerRadius="7" Padding="10">
                            <StackPanel>
                                <TextBlock Text="筛选布局" FontSize="14" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,9" />
                                <CheckBox x:Name="LayoutToggle" Content="在侧边显示筛选"
                                          Foreground="{StaticResource TextPrimaryBrush}" />
                                <TextBlock Text="开启时，干员和装备筛选显示在侧边。关闭后，筛选回到列表顶部。"
                                           Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,6,0,0" />
                            </StackPanel>
                        </Border>
                        <Border Background="{StaticResource CardBackgroundBrush}" BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1" CornerRadius="7" Padding="10" Margin="0,10,0,0">
                            <StackPanel>
                                <CheckBox x:Name="MarkerCalibrationToggle" Content="校准标记"
                                          Foreground="{StaticResource TextPrimaryBrush}" />
                                <TextBlock Text="开启后，拖动游戏内任意追踪标记。所有标记会一起移动，松手后保存。"
                                           Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,6,0,8" />
                                <Button x:Name="ResetMarkerOffsetButton" Content="恢复默认位置"
                                        Style="{StaticResource TrackingButton}" HorizontalAlignment="Left" Padding="8,5" />
                                <TextBlock x:Name="MarkerOffsetSaveError" Text="无法保存标记位置，请重试。"
                                           Foreground="#FFFFA6A6" TextWrapping="Wrap" Margin="0,6,0,0" Visibility="Collapsed" />
                            </StackPanel>
                        </Border>
                        <Border Background="{StaticResource CardBackgroundBrush}" BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1" CornerRadius="7" Padding="10" Margin="0,10,0,0">
                            <StackPanel>
                                <CheckBox x:Name="BobVoiceToggle" Content="默认鲍勃语音"
                                          Foreground="{StaticResource TextPrimaryBrush}" />
                                <TextBlock x:Name="BobVoiceStatus" Text="在开局、战前和战斗结算等时机播放，战备时会随机闲聊。"
                                           Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,6,0,8" />
                                <StackPanel Orientation="Horizontal">
                                    <Border x:Name="CannotPreviewPortrait" Width="30" Height="30"
                                            Margin="0,0,7,0" Padding="1" Background="#FF10242A"
                                            BorderBrush="#FF65C6BE" BorderThickness="1" CornerRadius="5">
                                        <Image Source="{Binding Source, ElementName=CannotPortraitImage}"
                                               Stretch="UniformToFill" AutomationProperties.Name="坎诺特" />
                                    </Border>
                                    <Button x:Name="BobVoicePreviewButton" Content="试听"
                                            Style="{StaticResource TrackingButton}" Padding="8,5" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                        <Border Background="{StaticResource CardBackgroundBrush}" BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1" CornerRadius="7" Padding="10" Margin="0,10,0,0">
                            <StackPanel>
                                <TextBlock Text="QQ群" FontSize="14" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,6" />
                                <DockPanel>
                                    <Button x:Name="SettingsCopyQqGroupButton" Content="复制群号" Click="OnCopyQqGroup"
                                            DockPanel.Dock="Right" Style="{StaticResource TrackingButton}" Padding="8,5" />
                                    <TextBlock x:Name="SettingsQqGroupNumber" Text="1085364202" VerticalAlignment="Center"
                                               Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,6,0" />
                                </DockPanel>
                                <TextBlock x:Name="SettingsQqGroupStatus" Foreground="{StaticResource TextSecondaryBrush}"
                                           TextWrapping="Wrap" Margin="0,6,0,0" Visibility="Collapsed"
                                           AutomationProperties.LiveSetting="Polite" />
                            </StackPanel>
                        </Border>
                        <Border x:Name="SettingsLineupAccountCard" Background="{StaticResource CardBackgroundBrush}"
                                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="7" Padding="10"
                                Margin="0,10,0,0" Visibility="Collapsed">
                            <StackPanel>
                                <TextBlock Text="卫戍阵容库" FontSize="14" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,6" />
                                <TextBlock x:Name="SettingsLineupAccountStatus" Foreground="{StaticResource TextSecondaryBrush}"
                                           TextWrapping="Wrap" Margin="0,0,0,8" />
                                <Button x:Name="SettingsLineupAccountButton" Click="OnSettingsLineupAccount"
                                        Style="{StaticResource TrackingButton}" HorizontalAlignment="Left" Padding="8,5" />
                            </StackPanel>
                        </Border>
                        <Border Background="{StaticResource CardBackgroundBrush}" BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1" CornerRadius="7" Padding="10" Margin="0,10,0,0">
                            <StackPanel>
                                <TextBlock Text="点击后将近期应用日志和更新失败日志发送到卫戍阵容库，用于排查问题。"
                                           Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,0,0,8" />
                                <Button x:Name="SettingsSendFeedbackButton" Content="发送反馈" Click="OnSendFeedback"
                                        Style="{StaticResource TrackingButton}" HorizontalAlignment="Left" Padding="8,5"
                                        IsEnabled="False" />
                                <TextBlock x:Name="SettingsFeedbackStatus" Foreground="{StaticResource TextSecondaryBrush}"
                                           TextWrapping="Wrap" Margin="0,6,0,0" Visibility="Collapsed"
                                           AutomationProperties.LiveSetting="Polite" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
            <Canvas x:Name="CannotSpeechLayer" Panel.ZIndex="10" IsHitTestVisible="False" ClipToBounds="True">
                <Grid x:Name="CannotSpeech" Visibility="Collapsed" Opacity="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="8" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Path VerticalAlignment="Top" Margin="0,10,-1,0" Panel.ZIndex="1"
                          Fill="#FF21373E" Stroke="#FF65C6BE" StrokeThickness="1"
                          Data="M 8,0 L 0,5 L 8,10" />
                    <Border Grid.Column="1" Background="#FF21373E" BorderBrush="#FF65C6BE"
                            BorderThickness="1" CornerRadius="8" Padding="9,6">
                        <TextBlock x:Name="CannotSpeechText" Foreground="#FFF2FFFC" TextWrapping="Wrap"
                                   FontSize="13" AutomationProperties.LiveSetting="Polite" />
                    </Border>
                    <Grid.RenderTransform>
                        <TranslateTransform x:Name="CannotSpeechMotion" />
                    </Grid.RenderTransform>
                </Grid>
            </Canvas>
                </Grid>
            </Grid>
        </DockPanel>
    </Border>
</Window>
