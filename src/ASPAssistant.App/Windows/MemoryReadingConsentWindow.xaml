<Window x:Class="ASPAssistant.App.Windows.MemoryReadingConsentWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="游戏内存读取风险提示" Icon="{StaticResource AspaLogo}"
        WindowStyle="None" ResizeMode="NoResize" WindowState="Maximized"
        WindowStartupLocation="CenterOwner" Topmost="True"
        Background="{StaticResource PanelBackgroundBrush}"
        PreviewKeyDown="OnPreviewKeyDown">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                  VerticalContentAlignment="Center" Focusable="False">
        <Grid Margin="24">
            <Border MaxWidth="620" Padding="28" HorizontalAlignment="Stretch"
                    Background="{StaticResource CardBackgroundBrush}" CornerRadius="12"
                    BorderThickness="1" BorderBrush="{StaticResource BorderBrush}">
                <StackPanel>
                    <TextBlock Text="ASP Assistant  /  账号风险提示" Foreground="#FFFFCA80" FontWeight="SemiBold" />
                    <TextBlock Text="是否使用内存读取相关功能？" Margin="0,14,0,12" FontSize="26"
                               TextWrapping="Wrap" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
                    <TextBlock FontSize="16" TextWrapping="Wrap" Foreground="{StaticResource TextPrimaryBrush}"
                               Text="DPS 统计、部分鲍勃（Bob）语音和房间识别需要读取游戏内存。此行为可能违反游戏用户协议，导致您的账号被封禁。" />
                    <TextBlock FontSize="15" Margin="0,16,0,0" TextWrapping="Wrap" Foreground="{StaticResource TextPrimaryBrush}"
                               Text="选择受限功能后，助手不会读取游戏内存。回合数、金币和商店等级改用画面识别（OCR），不依赖内存的语音仍可使用。" />
                    <TextBlock FontSize="14" Margin="0,12,0,16" TextWrapping="Wrap" Foreground="{StaticResource TextSecondaryBrush}"
                               Text="您可以随时在「设置 → 游戏内存读取」中重新查看此警告并更改选择。" />
                    <WrapPanel KeyboardNavigation.TabNavigation="Cycle">
                        <Button x:Name="RestrictedButton" Content="使用受限功能" Click="OnRestricted"
                                Style="{StaticResource TrackingButton}" Foreground="{StaticResource TextPrimaryBrush}"
                                BorderBrush="{StaticResource AccentBrush}" FontSize="15" MinHeight="44" Padding="16,8" Margin="0,6,10,0" />
                        <Button x:Name="FullButton" Content="继续使用全部功能" Click="OnFull"
                                Style="{StaticResource TrackingButton}" Foreground="{StaticResource TextPrimaryBrush}"
                                FontSize="15" MinHeight="44" Padding="16,8" Margin="0,6,0,0" />
                    </WrapPanel>
                </StackPanel>
            </Border>
        </Grid>
    </ScrollViewer>
</Window>
