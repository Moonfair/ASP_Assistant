<Window x:Class="ASPAssistant.App.Windows.GarrisonHistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:ASPAssistant.App.Controls"
        xmlns:wv="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="卫戍历史战绩 · ASP Assistant"
        Width="1160" Height="760" MinWidth="720" MinHeight="500"
        WindowStartupLocation="CenterScreen" Background="{StaticResource PanelBackgroundBrush}">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../Resources/LineupStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
            <Style x:Key="HistoryRecordRow" TargetType="ListBoxItem">
                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="Margin" Value="0,0,4,6" />
                <Setter Property="Padding" Value="12,8" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ListBoxItem">
                            <Border x:Name="Row" Background="{StaticResource CardBackgroundBrush}"
                                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="6"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Row" Property="Background" Value="#FF293450" />
                                </Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter TargetName="Row" Property="Background" Value="#FF244359" />
                                    <Setter TargetName="Row" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </Window.Resources>
    <DockPanel Margin="12">
        <TextBlock x:Name="Status" DockPanel.Dock="Bottom" Margin="4,8,0,0" TextWrapping="Wrap"
                   Foreground="{StaticResource TextSecondaryBrush}" AutomationProperties.LiveSetting="Polite" />
        <TabControl x:Name="HistoryTabs" Style="{StaticResource DarkTabControl}"
                    HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
            <TabItem Header="鹰角通行证" x:Name="SourceTab"
                     HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
                <DockPanel Margin="12">
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                        <Button x:Name="ReloadButton" DockPanel.Dock="Right" Content="重新打开鹰角官网" Click="OnReload"
                                Margin="8,0,0,0" />
                        <TextBlock Text="登录鹰角通行证后，自动拉取卫戍战绩。" TextWrapping="Wrap" VerticalAlignment="Center" />
                    </DockPanel>
                    <wv:WebView2 x:Name="Browser" />
                </DockPanel>
            </TabItem>
            <TabItem Header="历史阵容" x:Name="RecordsTab"
                     HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
                <Grid Margin="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="244" />
                        <ColumnDefinition Width="14" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Style="{StaticResource ItemCardBorder}" Background="#FF15162B" Margin="0" Padding="10">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Top" Text="对局记录" FontSize="14" FontWeight="SemiBold"
                                       Margin="2,0,0,10" />
                            <ListBox x:Name="Records" SelectionChanged="OnRecordSelected" ItemContainerStyle="{StaticResource HistoryRecordRow}"
                                     Background="Transparent" BorderThickness="0" Padding="0"
                                     AutomationProperties.Name="历史对局" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                     VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel>
                                            <DockPanel>
                                                <TextBlock DockPanel.Dock="Right" Text="{Binding Rounds}" Foreground="{StaticResource AccentBrush}"
                                                           FontSize="12" Margin="8,0,0,0" />
                                                <TextBlock Text="{Binding Time}" FontSize="14" FontWeight="SemiBold" />
                                            </DockPanel>
                                            <TextBlock Text="{Binding ModeAndDifficulty}" Foreground="{StaticResource TextSecondaryBrush}"
                                                       FontSize="12" Margin="0,3,0,0" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </DockPanel>
                    </Border>
                    <Border Grid.Column="2" Style="{StaticResource ItemCardBorder}" Background="#FF15162B" Margin="0" Padding="14">
                        <DockPanel>
                            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                                <Button x:Name="RefreshButton" DockPanel.Dock="Right" Content="刷新" Click="OnRefresh"
                                        IsEnabled="False" Margin="8,0,0,0" />
                                <ComboBox x:Name="RolePicker" DockPanel.Dock="Right" DisplayMemberPath="DisplayName"
                                          IsEditable="True" IsReadOnly="True" MinWidth="136" MaxWidth="220" Margin="8,0,0,0"
                                          Visibility="Collapsed" SelectionChanged="OnRoleChanged" AutomationProperties.Name="明日方舟角色" />
                                <StackPanel>
                                    <TextBlock x:Name="RecordTitle" Text="选择一场历史对局" FontSize="18"
                                               FontWeight="SemiBold" TextWrapping="Wrap" />
                                    <TextBlock x:Name="RecordStrategy" Foreground="{StaticResource AccentBrush}"
                                               Margin="0,4,0,0" TextWrapping="Wrap" />
                                </StackPanel>
                            </DockPanel>
                            <WrapPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
                                <Button x:Name="CopyButton" Content="复制阵容分享文本" IsEnabled="False" Click="OnCopy"
                                        Margin="0,0,8,0" />
                                <Button x:Name="EditButton" Content="在阵容编辑器中打开" IsEnabled="False" Click="OnEdit" />
                            </WrapPanel>
                            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                <StackPanel>
                                    <ItemsControl x:Name="Members">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Style="{StaticResource ItemCardBorder}" Width="152" MinHeight="94"
                                                        Margin="0,0,8,8" Padding="8" ToolTip="{Binding Name}">
                                                    <StackPanel>
                                                        <DockPanel Margin="0,0,0,6">
                                                            <Border DockPanel.Dock="Left" Width="40" Height="40" CornerRadius="5"
                                                                    Background="{StaticResource PanelBackgroundBrush}" Margin="0,0,8,0">
                                                                <Image controls:DeferredIcon.Path="{Binding IconPath}" Stretch="Uniform"
                                                                       AutomationProperties.Name="{Binding Name}" />
                                                            </Border>
                                                            <StackPanel VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding Name}" FontSize="12" FontWeight="SemiBold"
                                                                           TextTrimming="CharacterEllipsis" />
                                                                <TextBlock Text="精锐" FontSize="11" Foreground="{StaticResource AccentBrush}"
                                                                           Visibility="{Binding IsElite, Converter={StaticResource BoolToVisibility}}" />
                                                            </StackPanel>
                                                        </DockPanel>
                                                        <ItemsControl ItemsSource="{Binding Equipment}">
                                                            <ItemsControl.ItemsPanel>
                                                                <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                                                            </ItemsControl.ItemsPanel>
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate>
                                                                    <Border Background="{StaticResource PanelBackgroundBrush}" CornerRadius="4"
                                                                            Width="28" Height="28" Margin="0,0,5,0" ToolTip="{Binding Name}">
                                                                        <Image controls:DeferredIcon.Path="{Binding IconPath}" Stretch="Uniform"
                                                                               AutomationProperties.Name="{Binding Name}" />
                                                                    </Border>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <TextBlock x:Name="Omissions" Margin="0,6,0,0" Foreground="#FFFFCA80" TextWrapping="Wrap" />
                                </StackPanel>
                            </ScrollViewer>
                        </DockPanel>
                    </Border>
                </Grid>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
