<Window x:Class="ASPAssistant.App.Windows.GarrisonHistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="卫戍历史战绩 · ASP Assistant"
        Width="1160" Height="760" MinWidth="720" MinHeight="500"
        WindowStartupLocation="CenterScreen" Background="{StaticResource PanelBackgroundBrush}">
    <DockPanel Margin="12">
        <TextBlock x:Name="Status" DockPanel.Dock="Bottom" Margin="0,8,0,0" TextWrapping="Wrap"
                   Foreground="{StaticResource TextSecondaryBrush}" AutomationProperties.LiveSetting="Polite" />
        <TabControl x:Name="HistoryTabs" Style="{StaticResource DarkTabControl}">
            <TabItem Header="登录与拉取" x:Name="SourceTab">
                <DockPanel Margin="8">
                    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                        <TextBlock Text="在下方鹰角官网登录，然后点击「授权并拉取」。"
                                   TextWrapping="Wrap" Margin="0,0,0,8" />
                        <WrapPanel>
                            <Button x:Name="PullButton" Content="授权并拉取" Click="OnPull" IsEnabled="False" Margin="0,0,8,0" />
                            <Button x:Name="ReloadButton" Content="重新打开鹰角官网" Click="OnReload" Margin="0,0,8,0" />
                            <ComboBox x:Name="RolePicker" DisplayMemberPath="DisplayName" MinWidth="180" Visibility="Collapsed"
                                      AutomationProperties.Name="明日方舟角色" />
                        </WrapPanel>
                    </StackPanel>
                    <wv:WebView2 x:Name="Browser" />
                </DockPanel>
            </TabItem>
            <TabItem Header="历史阵容" x:Name="RecordsTab">
                <Grid Margin="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="260" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <ListBox x:Name="Records" DisplayMemberPath="Title" SelectionChanged="OnRecordSelected"
                             AutomationProperties.Name="历史对局"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" />
                    <DockPanel Grid.Column="1" Margin="14,0,0,0">
                        <WrapPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
                            <Button x:Name="CopyButton" Content="复制阵容分享文本" IsEnabled="False" Click="OnCopy" Margin="0,0,8,0" />
                            <Button x:Name="EditButton" Content="在阵容编辑器中打开" IsEnabled="False" Click="OnEdit" />
                        </WrapPanel>
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <StackPanel>
                                <TextBlock x:Name="RecordTitle" Text="选择一场历史对局" FontSize="18" FontWeight="SemiBold"
                                           TextWrapping="Wrap" />
                                <TextBlock x:Name="RecordStrategy" Margin="0,8,0,6" TextWrapping="Wrap" />
                                <ItemsControl x:Name="Members">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="0,7">
                                                <WrapPanel>
                                                    <TextBlock Text="{Binding OperatorName}" FontWeight="SemiBold" Margin="0,0,10,0" />
                                                    <TextBlock Text="精锐" Foreground="{StaticResource AccentBrush}" Margin="0,0,10,0">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsElite}" Value="True">
                                                                        <Setter Property="Visibility" Value="Visible" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                    <ItemsControl ItemsSource="{Binding EquipmentSlots}">
                                                        <ItemsControl.ItemsPanel>
                                                            <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                                                        </ItemsControl.ItemsPanel>
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <TextBlock Text="{Binding}" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,10,0">
                                                                    <TextBlock.Style>
                                                                        <Style TargetType="TextBlock">
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding}" Value="">
                                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </TextBlock.Style>
                                                                </TextBlock>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </WrapPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock x:Name="Omissions" Margin="0,10,0,0" Foreground="#FFFFCA80" TextWrapping="Wrap" />
                            </StackPanel>
                        </ScrollViewer>
                    </DockPanel>
                </Grid>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
