<Window x:Class="ASPAssistant.App.Windows.LineupEditorWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:views="clr-namespace:ASPAssistant.App.Views" xmlns:controls="clr-namespace:ASPAssistant.App.Controls" xmlns:models="clr-namespace:ASPAssistant.Core.Models;assembly=ASPAssistant.Core" Title="阵容编辑 · ASP Assistant" Width="1040" Height="780" MinWidth="820" MinHeight="640" WindowStartupLocation="CenterScreen" Background="{DynamicResource PanelBackgroundBrush}">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../Resources/LineupStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="BoolVisibility" />
            <Style x:Key="EffectHeading" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                <Setter Property="Margin" Value="0,8,0,3" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
            </Style>
            <Style x:Key="CovenantNames" TargetType="ItemsControl">
                <Setter Property="ItemsPanel">
                    <Setter.Value>
                        <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                    </Setter.Value>
                </Setter>
                <Setter Property="ItemTemplate">
                    <Setter.Value>
                        <DataTemplate><TextBlock Text="{Binding}" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,10,2" /></DataTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <DataTemplate DataType="{x:Type models:OperatorVariant}">
                <ItemsControl ItemsSource="{Binding Traits}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock TextWrapping="Wrap" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,5">
                                <TextBlock.Text>
                                    <MultiBinding StringFormat="{}{0}：{1}">
                                        <Binding Path="TraitType" />
                                        <Binding Path="TraitDescription" />
                                    </MultiBinding>
                                </TextBlock.Text>
                            </TextBlock>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </DataTemplate>
            <DataTemplate DataType="{x:Type models:Operator}">
                <StackPanel>
                    <TextBlock Text="{Binding TierLabel, StringFormat=等阶 {0}}" Foreground="{StaticResource TextSecondaryBrush}" />
                    <TextBlock Text="普通效果" Style="{StaticResource EffectHeading}" />
                    <ContentControl Content="{Binding Normal}" />
                    <TextBlock Text="精英效果" Style="{StaticResource EffectHeading}" />
                    <ContentControl Content="{Binding Elite}" />
                    <TextBlock Text="核心盟约" Style="{StaticResource EffectHeading}" />
                    <ItemsControl ItemsSource="{Binding CoreCovenants}" Style="{StaticResource CovenantNames}" />
                    <TextBlock Text="附加盟约" Style="{StaticResource EffectHeading}" />
                    <ItemsControl ItemsSource="{Binding AdditionalCovenants}" Style="{StaticResource CovenantNames}" />
                </StackPanel>
            </DataTemplate>
            <DataTemplate DataType="{x:Type models:EquipmentVariant}">
                <TextBlock TextWrapping="Wrap" Foreground="{StaticResource TextPrimaryBrush}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Text" Value="{Binding EffectDescription}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding EffectDescription}" Value="">
                                    <Setter Property="Text" Value="暂无效果资料" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </DataTemplate>
            <DataTemplate DataType="{x:Type models:Equipment}">
                <StackPanel>
                    <WrapPanel>
                        <TextBlock Text="{Binding Tier, StringFormat=等阶 {0}}" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,8,0" />
                        <TextBlock Foreground="{StaticResource TextSecondaryBrush}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                    <Setter Property="Text" Value="普通装备" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Type}" Value="{x:Static models:EquipmentType.JobChange}">
                                            <Setter Property="Text" Value="转职装备" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Type}" Value="{x:Static models:EquipmentType.Exclusive}">
                                            <Setter Property="Text" Value="专属装备" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </WrapPanel>
                    <TextBlock Text="普通效果" Style="{StaticResource EffectHeading}" />
                    <ContentControl Content="{Binding Normal}" />
                    <TextBlock Text="精英效果" Style="{StaticResource EffectHeading}" />
                    <ContentControl Content="{Binding Elite}" />
                    <TextBlock Text="{Binding FusionFormula, StringFormat=合成配方：{0}}" TextWrapping="Wrap" Margin="0,8,0,0">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding FusionFormula}" Value="">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </DataTemplate>
            <SolidColorBrush x:Key="MissingFieldBrush" Color="#FFFF637D" />
            <Style x:Key="MissingFieldOutline" TargetType="Border">
                <Setter Property="IsHitTestVisible" Value="False" />
                <Setter Property="Opacity" Value="0" />
                <Setter Property="BorderThickness" Value="2" />
                <Setter Property="BorderBrush" Value="{StaticResource MissingFieldBrush}" />
                <Style.Triggers>
                    <MultiDataTrigger>
                        <MultiDataTrigger.Conditions>
                            <Condition Binding="{Binding}" Value="True" />
                            <Condition Binding="{Binding DataContext.ShowRequiredFieldErrors, RelativeSource={RelativeSource AncestorType=Window}}" Value="True" />
                        </MultiDataTrigger.Conditions>
                        <Setter Property="Opacity" Value="1" />
                    </MultiDataTrigger>
                </Style.Triggers>
            </Style>
            <Style x:Key="RosterDropSurface" TargetType="Border">
                <Setter Property="Background" Value="#FF16162B" />
                <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
                <Style.Triggers>
                    <MultiDataTrigger>
                        <MultiDataTrigger.Conditions>
                            <Condition Binding="{Binding ShowRequiredFieldErrors}" Value="True" />
                            <Condition Binding="{Binding Members.Count}" Value="0" />
                        </MultiDataTrigger.Conditions>
                        <Setter Property="BorderBrush" Value="{StaticResource MissingFieldBrush}" />
                        <Setter Property="Background" Value="#FF322138" />
                    </MultiDataTrigger>
                    <MultiDataTrigger>
                        <MultiDataTrigger.Conditions>
                            <Condition Binding="{Binding (controls:LineupDragDrop.ActiveKind), RelativeSource={RelativeSource Self}}" Value="{x:Static controls:LineupDragKind.Operator}" />
                            <Condition Binding="{Binding CanAddOperator}" Value="True" />
                        </MultiDataTrigger.Conditions>
                        <Setter Property="Background" Value="#FF1D3549" />
                        <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                    </MultiDataTrigger>
                </Style.Triggers>
            </Style>
            <Style x:Key="EmptyEquipmentHint" TargetType="Border">
                <Setter Property="IsHitTestVisible" Value="False" />
                <Setter Property="Opacity" Value="0" />
                <Setter Property="Background" Value="#3033BBFF" />
                <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                <Setter Property="BorderThickness" Value="2" />
                <Setter Property="CornerRadius" Value="4" />
                <Style.Triggers>
                    <MultiDataTrigger>
                        <MultiDataTrigger.Conditions>
                            <Condition Binding="{Binding (controls:LineupDragDrop.ActiveKind), RelativeSource={RelativeSource Self}}" Value="{x:Static controls:LineupDragKind.Equipment}" />
                            <Condition Binding="{Binding}" Value="False" />
                        </MultiDataTrigger.Conditions>
                        <Setter Property="Opacity" Value="1" />
                    </MultiDataTrigger>
                </Style.Triggers>
            </Style>
            <Style x:Key="RosterItem" TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                <Setter Property="Width" Value="106" />
                <Setter Property="Padding" Value="6" />
                <Setter Property="Margin" Value="0,0,6,8" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ListBoxItem">
                            <Border x:Name="Card" Background="{StaticResource CardBackgroundBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="7" Padding="{TemplateBinding Padding}">
                                <ContentPresenter />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter TargetName="Card" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                    <Setter TargetName="Card" Property="Background" Value="#FF263F55" />
                                </Trigger>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Card" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </Window.Resources>
    <AdornerDecorator>
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <DockPanel Margin="0,0,0,14">
            <TextBlock x:Name="WorkspaceMemberCount" Text="{Binding MemberCount}" DockPanel.Dock="Right" Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center" FontSize="16" />
            <StackPanel>
                <TextBlock x:Name="WorkspaceTitle" Text="构建你的阵容" FontSize="22" FontWeight="SemiBold" />
                <TextBlock x:Name="WorkspaceHint" Text="拖入干员组成阵容，再把装备拖到干员头像或指定装备槽。" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,0" />
            </StackPanel>
        </DockPanel>
        <Grid x:Name="IdentityFields" Grid.Row="1" Margin="0,0,0,14">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition />
                <ColumnDefinition />
            </Grid.ColumnDefinitions>
            <StackPanel Margin="0,0,12,0">
                <TextBlock Text="阵容名称" Margin="0,0,0,5" />
                <Grid>
                    <TextBox x:Name="NameInput" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" MaxLength="80" AutomationProperties.Name="阵容名称" />
                    <Border x:Name="MissingNameOutline" Style="{StaticResource MissingFieldOutline}" DataContext="{Binding IsNameMissing}" />
                </Grid>
            </StackPanel>
            <StackPanel Grid.Column="1">
                <TextBlock Text="作者名称" Margin="0,0,0,5" />
                <Grid>
                    <TextBox x:Name="AuthorInput" Text="{Binding Author, UpdateSourceTrigger=PropertyChanged}" MaxLength="80" AutomationProperties.Name="作者名称" />
                    <Border x:Name="MissingAuthorOutline" Style="{StaticResource MissingFieldOutline}" DataContext="{Binding IsAuthorMissing}" />
                </Grid>
            </StackPanel>
            <Expander Grid.Row="1" Grid.ColumnSpan="2" Header="{Binding CovenantTagSummary}" Margin="0,8,0,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="100">
                    <ItemsControl ItemsSource="{Binding CovenantTagOptions}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <CheckBox Content="{Binding Name}" IsChecked="{Binding IsSelected}" Margin="0,4,12,0" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Expander>
        </Grid>
        <Grid x:Name="RosterWorkspace" Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="0.65*" MinWidth="260" MaxWidth="350" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Background="#FF16162B" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="6">
                <views:LineupCatalogView x:Name="Catalog" />
            </Border>
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <DockPanel Margin="0,0,0,8">
                    <TextBlock Text="阵容干员" FontWeight="SemiBold" />
                    <TextBlock Text="点击头像，在下方编辑" HorizontalAlignment="Right" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" />
                </DockPanel>
                <Border x:Name="RosterDropZone" Grid.Row="1" AllowDrop="True" DragOver="OnRosterDragOver" Drop="OnRosterDrop" Style="{StaticResource RosterDropSurface}" CornerRadius="6" BorderThickness="1" Padding="8">
                    <Grid>
                        <TextBlock Text="将左侧干员拖到这里&#xA;最多可加入 30 名干员" TextAlignment="Center" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}" LineHeight="24">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Members.Count}" Value="0">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <ListBox x:Name="RosterList" ItemsSource="{Binding Members}" SelectedItem="{Binding SelectedMember, Mode=TwoWay}" PreviewMouseLeftButtonDown="OnRosterMemberClick" Background="Transparent" BorderThickness="0" Padding="0" ItemContainerStyle="{StaticResource RosterItem}" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto">
                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ListBox.ItemsPanel>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border x:Name="MemberDropTarget" Background="Transparent" AllowDrop="True" DragOver="OnMemberDragOver" Drop="OnMemberDrop">
                                        <StackPanel>
                                            <Grid>
                                                <Border Width="64" Height="64" Background="#FF12122A" CornerRadius="5">
                                                    <Grid>
                                                        <TextBlock Text="?" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                        <Image controls:DeferredIcon.Path="{Binding IconPath}" Stretch="Uniform" />
                                                    </Grid>
                                                </Border>
                                                <Border Background="#FF277770" HorizontalAlignment="Left" VerticalAlignment="Top" Padding="3,1" CornerRadius="3" Visibility="{Binding IsStackingCore, Converter={StaticResource BoolVisibility}}" ToolTip="叠层核心">
                                                    <TextBlock Text="叠" Foreground="White" FontSize="10" />
                                                </Border>
                                                <Border Background="#FF99542C" HorizontalAlignment="Right" VerticalAlignment="Top" Padding="3,1" CornerRadius="3" Visibility="{Binding IsDamageCore, Converter={StaticResource BoolVisibility}}" ToolTip="输出核心">
                                                    <TextBlock Text="攻" Foreground="White" FontSize="10" />
                                                </Border>
                                            </Grid>
                                            <ItemsControl ItemsSource="{Binding EquipmentSlots}" HorizontalAlignment="Center" Margin="0,4,0,0">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate><UniformGrid Columns="2" /></ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Grid Width="36" Height="36" Margin="3,0" Tag="{Binding Tag}" AllowDrop="True" DragOver="OnSlotDragOver" Drop="OnSlotDrop" ToolTip="{Binding Name, StringFormat=装备：{0}（拖入可替换）}">
                                                            <Border Margin="0,4,4,0" Background="#FF12122A" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="4">
                                                                <Grid>
                                                                    <Border Style="{StaticResource EmptyEquipmentHint}" DataContext="{Binding HasEquipment}" />
                                                                    <TextBlock Text="＋" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                                    <Image controls:DeferredIcon.Path="{Binding IconPath}" Stretch="Uniform" />
                                                                </Grid>
                                                            </Border>
                                                            <Button Content="×" Click="OnClearEquipment" HorizontalAlignment="Right" VerticalAlignment="Top" Width="15" Height="15" Padding="0" FontSize="11" Background="#FF893F50" Foreground="White" Visibility="{Binding HasEquipment, Converter={StaticResource BoolVisibility}}" ToolTip="{Binding Label, StringFormat=清除{0}}" AutomationProperties.Name="{Binding Label, StringFormat=清除{0}}" />
                                                        </Grid>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                            <TextBlock Text="{Binding OperatorName}" Foreground="{StaticResource TextPrimaryBrush}" FontSize="12" TextAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding OperatorName}" Margin="0,5,0,0" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </Border>
                <Border Grid.Row="2" Margin="0,12,0,0" Padding="12" Background="{StaticResource CardBackgroundBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="6">
                    <Grid>
                      <Grid>
                        <Grid.Style>
                            <Style TargetType="Grid">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CatalogPreview}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding (controls:LineupDragDrop.ActiveKind), RelativeSource={RelativeSource Self}}" Value="{x:Static controls:LineupDragKind.Equipment}">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Grid.Style>
                        <TextBlock Text="选择一名阵容干员，在这里编辑核心标记与装备。" TextWrapping="Wrap" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,16">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedMember}" Value="{x:Null}">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <ScrollViewer x:Name="MemberDetailScroll" IsVisibleChanged="OnMemberDetailVisibilityChanged"
                                      VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" MaxHeight="230">
                            <StackPanel x:Name="MemberEditor" DataContext="{Binding SelectedMember}" DataContextChanged="OnMemberDetailChanged">
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding}" Value="{x:Null}">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                <DockPanel Margin="0,0,0,10">
                                    <Button Content="移出阵容" DockPanel.Dock="Right" Click="OnRemoveMember" Padding="8,3" />
                                    <TextBlock Text="{Binding OperatorName}" FontSize="17" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
                                </DockPanel>
                                <WrapPanel Margin="0,0,0,12">
                                    <CheckBox Content="叠层核心" IsChecked="{Binding IsStackingCore}" />
                                    <CheckBox Content="输出核心" IsChecked="{Binding IsDamageCore}" />
                                    <CheckBox Content="精锐" IsChecked="{Binding IsElite}" Margin="10,0,0,0"
                                              Visibility="{Binding CanBecomeElite, Converter={StaticResource BoolVisibility}}"
                                              ToolTip="用于计算精锐干员激活的盟约" />
                                </WrapPanel>
                                <ItemsControl ItemsSource="{Binding EquipmentSlots}" Margin="-5,0">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate><UniformGrid Columns="2" /></ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Margin="5,0,5,4">
                                                <TextBlock Text="{Binding Label}" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4" />
                                                <Grid>
                                                    <ComboBox ItemsSource="{Binding DataContext.EquipmentNames, RelativeSource={RelativeSource AncestorType=Window}}" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" IsEditable="True" IsTextSearchEnabled="True" MaxDropDownHeight="240" AutomationProperties.Name="{Binding Label}" AllowDrop="True" PreviewDragEnter="OnEditorSlotDragOver" PreviewDragOver="OnEditorSlotDragOver" PreviewDrop="OnEditorSlotDrop" />
                                                    <Border Style="{StaticResource EmptyEquipmentHint}" DataContext="{Binding HasEquipment}" />
                                                </Grid>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <ContentControl Content="{Binding Operator}" Margin="0,10,0,0" />
                                <TextBlock Text="当前目录中没有此干员的效果资料。" Margin="0,6,0,0">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Operator}" Value="{x:Null}">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </ScrollViewer>
                      </Grid>
                      <ScrollViewer x:Name="CatalogDetailScroll" DataContext="{Binding CatalogPreview}" DataContextChanged="OnCatalogDetailChanged"
                                    VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" MaxHeight="230">
                          <ScrollViewer.Style>
                              <Style TargetType="ScrollViewer">
                                  <Style.Triggers>
                                      <DataTrigger Binding="{Binding}" Value="{x:Null}">
                                          <Setter Property="Visibility" Value="Collapsed" />
                                      </DataTrigger>
                                      <DataTrigger Binding="{Binding (controls:LineupDragDrop.ActiveKind), RelativeSource={RelativeSource Self}}" Value="{x:Static controls:LineupDragKind.Equipment}">
                                          <Setter Property="Visibility" Value="Collapsed" />
                                      </DataTrigger>
                                  </Style.Triggers>
                              </Style>
                          </ScrollViewer.Style>
                          <StackPanel>
                              <DockPanel Margin="0,0,0,5" VerticalAlignment="Center">
                                  <Button Content="返回阵容干员" DockPanel.Dock="Right" Click="OnReturnToMember" Padding="8,3" />
                                  <Image Width="30" Height="30" Margin="0,0,8,0" controls:DeferredIcon.Path="{Binding IconPath}" />
                                  <TextBlock Text="{Binding Name}" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center" TextWrapping="Wrap" />
                              </DockPanel>
                              <ContentControl Content="{Binding}" />
                          </StackPanel>
                      </ScrollViewer>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
        <DockPanel x:Name="DescriptionStage" Grid.Row="2" Visibility="Collapsed">
            <StackPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                <DockPanel Margin="0,0,0,5">
                    <TextBlock Text="头像和装备可拖入流程图" DockPanel.Dock="Right" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                    <TextBlock Text="当前阵容干员" FontWeight="SemiBold" />
                </DockPanel>
                <ScrollViewer MaxHeight="140" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <views:LineupMemberStrip x:Name="CurrentMemberStrip" DataContext="{Binding Members}" CanDragIcons="True" />
                </ScrollViewer>
            </StackPanel>
            <views:LineupDescriptionView x:Name="DescriptionWorkspace" Visibility="Collapsed" />
        </DockPanel>
        <DockPanel x:Name="CompletedStage" Grid.Row="2" Visibility="Collapsed">
            <TextBox x:Name="ShareFallback" DockPanel.Dock="Bottom" Visibility="Collapsed" IsReadOnly="True"
                     Height="92" Margin="0,8,0,0" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                     AutomationProperties.Name="阵容分享文本" />
            <views:LineupPreviewView x:Name="CompletedPreview" />
        </DockPanel>
        <DockPanel Grid.Row="3" Margin="0,14,0,0">
            <Button x:Name="BackButton" DockPanel.Dock="Left" Content="上一步" Click="OnPreviousStep" Visibility="Collapsed" Margin="0,0,10,0" />
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Bottom">
                <Button x:Name="CancelButton" Content="取消" Click="OnCancel" Margin="8,0,8,0" />
                <Button x:Name="NextButton" Content="下一步" Click="OnNextStep" Foreground="{StaticResource AccentBrush}" />
                <Button x:Name="SaveButton" Content="保存阵容" Click="OnSave" Visibility="Collapsed" Foreground="{StaticResource AccentBrush}" />
                <Button x:Name="ShareButton" Content="分享阵容" Click="OnShare" Visibility="Collapsed" Foreground="{StaticResource AccentBrush}" Margin="8,0" />
                <Button x:Name="DoneButton" Content="完成" Click="OnCancel" Visibility="Collapsed" />
            </StackPanel>
            <TextBlock Text="{Binding Status}" Foreground="#FFFFCA80" TextWrapping="Wrap" VerticalAlignment="Center" />
        </DockPanel>
    </Grid>
    </AdornerDecorator>
</Window>
