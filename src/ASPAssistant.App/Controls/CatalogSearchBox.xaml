<UserControl x:Class="ASPAssistant.App.Controls.CatalogSearchBox"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Name="Host">
    <Border CornerRadius="6" BorderThickness="1" Background="{StaticResource CardBackgroundBrush}">
        <Border.Style>
            <Style TargetType="Border">
                <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
                <Style.Triggers>
                    <Trigger Property="IsKeyboardFocusWithin" Value="True">
                        <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                    </Trigger>
                </Style.Triggers>
            </Style>
        </Border.Style>
        <Grid MinHeight="32">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="31" /><ColumnDefinition /><ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Path Data="M 6,1 A 5,5 0 1 0 6.01,1 M 10,10 L 14,14" StrokeThickness="1.5" StrokeEndLineCap="Round"
                  Stroke="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"
                  IsHitTestVisible="False" />
            <TextBox x:Name="Input" Grid.Column="1" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                     AutomationProperties.Name="{Binding Hint, ElementName=Host}" BorderThickness="0"
                     Padding="0" VerticalContentAlignment="Center" Background="Transparent" FontSize="13"
                     Foreground="{StaticResource TextPrimaryBrush}" CaretBrush="{StaticResource AccentBrush}" />
            <TextBlock Grid.Column="1" Text="{Binding Hint, ElementName=Host}" IsHitTestVisible="False" VerticalAlignment="Center"
                       Foreground="{StaticResource TextSecondaryBrush}" FontSize="13">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Text, ElementName=Input}" Value=""><Setter Property="Visibility" Value="Visible" /></DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
            <Button Grid.Column="2" Content="×" Click="OnClear" ToolTip="清除搜索" AutomationProperties.Name="清除搜索"
                    Width="30" Margin="0,1,1,1" Padding="0" FontSize="16" BorderThickness="0">
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource TrackingButton}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Text, ElementName=Input}" Value=""><Setter Property="Visibility" Value="Collapsed" /></DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
        </Grid>
    </Border>
</UserControl>
