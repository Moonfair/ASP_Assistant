<UserControl x:Class="ASPAssistant.App.Controls.EquipmentCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:ASPAssistant.App.Converters">
    <UserControl.Resources>
        <converters:TierToRomanConverter x:Key="TierToRoman" />
    </UserControl.Resources>

    <Border Style="{StaticResource ItemCardBorder}" MouseLeftButtonUp="OnDetailClick">
        <StackPanel>
            <!-- Identity and primary action share a row at every panel width. -->
            <DockPanel>
                <!-- Icon (left, top-aligned) -->
                <Border DockPanel.Dock="Left" Width="48" Height="48" Margin="0,0,8,0"
                        CornerRadius="4" Background="#22FFFFFF" VerticalAlignment="Top"
                        ClipToBounds="True">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="BorderThickness" Value="0" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsChecked, ElementName=EliteToggle}" Value="True">
                                    <Setter Property="BorderThickness" Value="2" />
                                    <Setter Property="BorderBrush" Value="#FFD700" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <Image x:Name="IconImage" Stretch="UniformToFill" />
                </Border>

                <Button x:Name="TrackButton" DockPanel.Dock="Right" Style="{StaticResource CatalogTrackAction}"
                        Margin="6,0,0,0" VerticalAlignment="Center" Click="OnTrackClick" />
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{Binding Tier, Converter={StaticResource TierToRoman}, StringFormat='等阶 {0}'}"
                               Foreground="{StaticResource AccentBrush}" FontSize="11" />
                    <TextBlock Text="{Binding Name}" TextWrapping="Wrap" FontSize="15" FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimaryBrush}" />
                </StackPanel>
            </DockPanel>
            <DockPanel Margin="0,8,0,0" LastChildFill="False">
                <Border DockPanel.Dock="Left" CornerRadius="9"
                        BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                        Background="#1A4FC3F7" Padding="2" VerticalAlignment="Top">
                    <StackPanel Orientation="Horizontal">
                        <ToggleButton x:Name="NormalToggle" Content="普通"
                                      IsChecked="True"
                                      Style="{StaticResource VariantToggleButton}"
                                      Click="OnNormalClick" />
                        <ToggleButton x:Name="EliteToggle" Content="精锐"
                                      Style="{StaticResource VariantToggleButton}"
                                      Click="OnEliteClick" />
                    </StackPanel>
                </Border>
                <Button DockPanel.Dock="Right" Content="详情" Style="{StaticResource TrackingButton}" MinHeight="24"
                        Padding="8,2" Click="OnDetailClick" />
            </DockPanel>

            <TextBlock x:Name="EffectText" Margin="0,4,0,0"
                       FontSize="12" Foreground="{StaticResource TextPrimaryBrush}"
                       TextWrapping="Wrap" />
            <TextBlock Text="{Binding FusionFormula, StringFormat='合成：{0}'}" Margin="0,5,0,0"
                       FontSize="12" Foreground="{StaticResource AccentBrush}" TextWrapping="Wrap">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding FusionFormula, TargetNullValue='', FallbackValue=''}" Value="">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </StackPanel>
    </Border>
</UserControl>
