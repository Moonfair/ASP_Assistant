<UserControl x:Class="ASPAssistant.App.Controls.OperatorCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:ASPAssistant.App.Controls"
             xmlns:converters="clr-namespace:ASPAssistant.App.Converters">
    <UserControl.Resources>
        <converters:TierToRomanConverter x:Key="TierToRoman" />
        <converters:CovenantDisabledConverter x:Key="CovenantDisabled" />
        <Style x:Key="CoreCovenantTag" TargetType="Border">
            <Style.Triggers>
                <DataTrigger Value="True">
                    <DataTrigger.Binding>
                        <MultiBinding Converter="{StaticResource CovenantDisabled}">
                            <Binding />
                            <Binding Path="CovenantAvailability.EnabledCore" RelativeSource="{RelativeSource AncestorType=controls:OperatorCard}" />
                        </MultiBinding>
                    </DataTrigger.Binding>
                    <Setter Property="Opacity" Value="0.5" />
                    <Setter Property="ToolTip" Value="本局禁用" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="AdditionalCovenantTag" TargetType="Border">
            <Style.Triggers>
                <DataTrigger Value="True">
                    <DataTrigger.Binding>
                        <MultiBinding Converter="{StaticResource CovenantDisabled}">
                            <Binding />
                            <Binding Path="CovenantAvailability.EnabledAdditional" RelativeSource="{RelativeSource AncestorType=controls:OperatorCard}" />
                        </MultiBinding>
                    </DataTrigger.Binding>
                    <Setter Property="Opacity" Value="0.5" />
                    <Setter Property="ToolTip" Value="本局禁用" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Border x:Name="CardBorder" Style="{StaticResource ItemCardBorder}" MouseLeftButtonUp="OnDetailClick">
        <StackPanel>
            <!-- Identity and primary action share a row at every panel width. -->
            <DockPanel>
                <!-- Icon (left, top-aligned) with ban badge overlay -->
                <Grid DockPanel.Dock="Left" Width="48" Height="48" Margin="0,0,8,0"
                      VerticalAlignment="Top">
                    <Border CornerRadius="4" Background="#22FFFFFF" ClipToBounds="True">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="BorderThickness" Value="0" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsChecked, ElementName=EliteToggle}" Value="True">
                                        <Setter Property="BorderThickness" Value="2" />
                                        <Setter Property="BorderBrush" Value="#FFD700" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <Image x:Name="IconImage" Stretch="UniformToFill" />
                    </Border>
                    <!-- Ban overlay: dim layer -->
                    <Border x:Name="BanDimOverlay" CornerRadius="4"
                            Background="#88000000" Visibility="Collapsed" />
                    <!-- Ban badge: "禁用" chip in bottom-right corner -->
                    <Border x:Name="BanBadge" CornerRadius="4,0,4,0"
                            Background="#CCDD2222" Padding="4,2"
                            HorizontalAlignment="Right" VerticalAlignment="Bottom"
                            Visibility="Collapsed">
                        <TextBlock Text="禁用" FontSize="10" FontWeight="Bold"
                                   Foreground="White" />
                    </Border>
                </Grid>

                <Button x:Name="TrackButton" DockPanel.Dock="Right" Style="{StaticResource CatalogTrackAction}"
                        Margin="6,0,0,0" VerticalAlignment="Center" Click="OnTrackClick" />
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{Binding Tier, Converter={StaticResource TierToRoman}, StringFormat='等阶 {0}'}"
                               Foreground="{StaticResource AccentBrush}" FontSize="11" />
                    <TextBlock Text="{Binding Name}" TextWrapping="Wrap" FontSize="15" FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimaryBrush}" />
                </StackPanel>
            </DockPanel>
            <DockPanel Margin="0,8,0,0" LastChildFill="False">
                <Border x:Name="VariantPicker" DockPanel.Dock="Left" CornerRadius="9"
                        BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                        Background="#1A4FC3F7" Padding="2" VerticalAlignment="Top">
                    <StackPanel Orientation="Horizontal">
                        <ToggleButton x:Name="NormalToggle" Content="普通"
                                      IsChecked="True"
                                      Style="{StaticResource VariantToggleButton}"
                                      Click="OnNormalClick" />
                        <ToggleButton x:Name="EliteToggle" Content="精锐"
                                      Style="{StaticResource VariantToggleButton}"
                                      Click="OnEliteClick" />
                    </StackPanel>
                </Border>
                <Button DockPanel.Dock="Right" Content="详情" Style="{StaticResource TrackingButton}" MinHeight="24"
                        Padding="8,2" Click="OnDetailClick" />
                <Button x:Name="BanButton" DockPanel.Dock="Right" Style="{StaticResource BanToggleButton}"
                        MinHeight="24" Padding="8,2" Margin="0,0,6,0" Click="OnBanClick" />
            </DockPanel>

            <!-- Covenants -->
            <WrapPanel Margin="0,6,0,0">
                <ItemsControl ItemsSource="{Binding CoreCovenants}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource CoreCovenantTag}" CornerRadius="8" Background="#224FC3F7"
                                    Padding="7,2" Margin="0,0,4,0">
                                <StackPanel Orientation="Horizontal">
                                    <controls:CovenantIcon Covenant="{Binding}" Width="15" Height="15" Margin="0,0,4,0"
                                                           Foreground="{StaticResource AccentBrush}" />
                                    <TextBlock Text="{Binding}"
                                           Foreground="{StaticResource AccentBrush}"
                                           FontSize="13" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <ItemsControl ItemsSource="{Binding AdditionalCovenants}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource AdditionalCovenantTag}" CornerRadius="8" Background="#14FFFFFF"
                                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                    Padding="7,2" Margin="0,0,4,0">
                                <StackPanel Orientation="Horizontal">
                                    <controls:CovenantIcon Covenant="{Binding}" Width="15" Height="15" Margin="0,0,4,0"
                                                           Foreground="{StaticResource TextSecondaryBrush}" />
                                    <TextBlock Text="{Binding}"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           FontSize="13" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </WrapPanel>

            <!-- Traits -->
            <ItemsControl x:Name="TraitsPanel" Margin="0,6,0,0">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="0,0,0,4">
                            <!-- Trait type chip -->
                            <Border Style="{StaticResource TraitTagBorder}"
                                    Padding="6,2" HorizontalAlignment="Left">
                                <TextBlock Text="{Binding TraitType}"
                                           FontSize="12" Foreground="{StaticResource AccentBrush}" />
                            </Border>
                            <!-- Trait description -->
                            <TextBlock Text="{Binding TraitDescription}"
                                       FontSize="12" Foreground="{StaticResource TextPrimaryBrush}"
                                       TextWrapping="Wrap" Margin="0,2,0,0" />
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

        </StackPanel>
    </Border>
</UserControl>
