<UserControl x:Class="ASPAssistant.App.Views.EnemyView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries><ResourceDictionary Source="../Resources/SidebarChoiceStyles.xaml" /></ResourceDictionary.MergedDictionaries>
            <Style x:Key="RouteThumbnail" TargetType="Button" BasedOn="{StaticResource TrackingButton}">
                <Setter Property="Margin" Value="0,3,0,0" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="BorderBrush" Value="Transparent" />
                <Setter Property="ToolTip" Value="点击放大路线图" />
                <Style.Triggers>
                    <Trigger Property="IsKeyboardFocused" Value="True">
                        <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                    </Trigger>
                </Style.Triggers>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>
    <DockPanel Margin="8">
        <TextBlock DockPanel.Dock="Top" x:Name="PageHeading" Text="敌人情报" Style="{StaticResource SidebarPageTitle}" Margin="0,0,0,8" />
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel x:Name="Details">
                <Border Style="{StaticResource SidebarSurface}">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition /></Grid.ColumnDefinitions>
                        <TextBlock Grid.ColumnSpan="2" x:Name="EmptyMessage" Text="等待 BP 识别，也可手动选择。" Margin="0,0,0,6"
                                   TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" />
                        <TextBlock Grid.Row="1" Text="领袖" Style="{StaticResource SidebarSectionLabel}" Margin="0,0,8,0" VerticalAlignment="Center" />
                        <ComboBox Grid.Row="1" Grid.Column="1" x:Name="BossPicker" DisplayMemberPath="Label" Style="{StaticResource SidebarChoice}"
                                  AutomationProperties.Name="敌方领袖" MaxDropDownHeight="264" SelectionChanged="OnBossChanged" />
                        <TextBlock Grid.Row="2" Text="战场" Style="{StaticResource SidebarSectionLabel}" Margin="0,4,8,0" VerticalAlignment="Center" />
                        <ComboBox Grid.Row="2" Grid.Column="1" x:Name="BattlefieldPicker" DisplayMemberPath="Label" Margin="0,4,0,0" Style="{StaticResource SidebarChoice}"
                                  AutomationProperties.Name="战场" MaxDropDownHeight="264" SelectionChanged="OnBattlefieldChanged" />
                        <TextBlock Grid.Row="3" Text="特训敌人" Style="{StaticResource SidebarSectionLabel}" Margin="0,6,8,0" />
                        <TextBlock Grid.Row="3" Grid.Column="1" x:Name="EnemyTypes" Margin="0,6,0,0" TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource TextPrimaryBrush}" />
                    </Grid>
                </Border>
                <TextBlock Text="领袖路线" Style="{StaticResource SidebarSectionLabel}" Margin="0,10,0,4" />
                <ListBox x:Name="RoundPicker" SelectedIndex="0" SelectionChanged="OnRoundChanged" AutomationProperties.Name="路线回合"
                         ItemContainerStyle="{StaticResource SidebarSegment}">
                    <ListBox.Template>
                        <ControlTemplate TargetType="ListBox"><Border Background="#FF151B2B" CornerRadius="5" Padding="2"><ItemsPresenter /></Border></ControlTemplate>
                    </ListBox.Template>
                    <ListBox.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="2" /></ItemsPanelTemplate></ListBox.ItemsPanel>
                    <ListBoxItem Content="第 14 回合" /><ListBoxItem Content="第 15 回合" />
                </ListBox>
                <ItemsControl x:Name="Routes" Margin="0,6,0,0">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource SidebarSurface}">
                                <StackPanel>
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Right" Text="点击图片放大" Margin="6,0,0,0" VerticalAlignment="Center"
                                                   Visibility="{Binding RouteVisibility}" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" />
                                        <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap"
                                                   Foreground="{StaticResource TextPrimaryBrush}" />
                                    </DockPanel>
                                    <TextBlock Text="{Binding Status}" Visibility="{Binding StatusVisibility}" TextWrapping="Wrap"
                                               Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" Margin="0,4,0,0" />
                                    <StackPanel Visibility="{Binding RouteVisibility}">
                                        <ComboBox ItemsSource="{Binding SideChoices}" SelectedIndex="{Binding Side}" Style="{StaticResource SidebarChoice}"
                                                  AutomationProperties.Name="{Binding SidePickerName}" Margin="0,6,0,2" />
                                        <StackPanel Visibility="{Binding LeftVisibility}" Margin="0,5,0,0">
                                            <TextBlock Text="{Binding LeftOrder, StringFormat='左侧 · {0}'}" Foreground="#FF7CDBE9" FontSize="12" TextWrapping="Wrap" />
                                            <Button Style="{StaticResource RouteThumbnail}" Click="OnPreviewRoute"
                                                    Tag="{Binding LeftOrder}" AutomationProperties.Name="放大左侧路线图">
                                                <Image Source="{Binding LeftImage}" AutomationProperties.Name="左侧路线图" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" />
                                            </Button>
                                        </StackPanel>
                                        <StackPanel Visibility="{Binding RightVisibility}" Margin="0,6,0,0">
                                            <TextBlock Text="{Binding RightOrder, StringFormat='右侧 · {0}'}" Foreground="#FFFFC37A" FontSize="12" TextWrapping="Wrap" />
                                            <Button Style="{StaticResource RouteThumbnail}" Click="OnPreviewRoute"
                                                    Tag="{Binding RightOrder}" AutomationProperties.Name="放大右侧路线图">
                                                <Image Source="{Binding RightImage}" AutomationProperties.Name="右侧路线图" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" />
                                            </Button>
                                        </StackPanel>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</UserControl>
