<UserControl x:Class="ASPAssistant.App.Views.LineupView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:ASPAssistant.App.Controls"
             xmlns:converters="clr-namespace:ASPAssistant.App.Converters"
             xmlns:viewModels="clr-namespace:ASPAssistant.Core.ViewModels;assembly=ASPAssistant.Core"
             xmlns:views="clr-namespace:ASPAssistant.App.Views">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../Resources/LineupStyles.xaml" />
                <ResourceDictionary Source="../Resources/LineupActionIcons.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <CollectionViewSource x:Key="FilteredLineups" Source="{Binding Lineups}" Filter="OnFilterLineup" />
            <converters:StrategyCardPortraitsConverter x:Key="StrategyCardPortraits" />
            <converters:LineupActiveCovenantsConverter x:Key="LineupActiveCovenants" />
            <converters:LineupMoveEnabledConverter x:Key="LineupMoveEnabled" />
            <converters:LineupTrackingConverter x:Key="LineupTracking" />
            <BooleanToVisibilityConverter x:Key="ShowWhenChecked" />
            <Style x:Key="LineupCardAction" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                <Setter Property="MinHeight" Value="28" />
                <Setter Property="Padding" Value="3,3" />
                <Setter Property="FontSize" Value="12" />
            </Style>
            <Style x:Key="LineupCardActionIcon" TargetType="Path">
                <Setter Property="Width" Value="13" />
                <Setter Property="Height" Value="13" />
                <Setter Property="Stretch" Value="Uniform" />
                <Setter Property="Fill" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                <Setter Property="Margin" Value="0,0,5,0" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>
            <Style x:Key="LineupMoveAction" TargetType="Button" BasedOn="{StaticResource LineupCardAction}">
                <Setter Property="IsEnabled">
                    <Setter.Value>
                        <MultiBinding Converter="{StaticResource LineupMoveEnabled}">
                            <Binding Path="(ItemsControl.AlternationIndex)" RelativeSource="{RelativeSource AncestorType=ContentPresenter}" />
                            <Binding Path="Items.Count" RelativeSource="{RelativeSource AncestorType=ItemsControl}" />
                            <Binding Path="Tag" RelativeSource="{RelativeSource Self}" />
                        </MultiBinding>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style x:Key="CategorySegment" TargetType="ListBoxItem">
                <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
                <Setter Property="Padding" Value="3,7" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="Margin" Value="1" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ListBoxItem">
                            <Border x:Name="Segment" CornerRadius="5" Background="Transparent" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Segment" Property="Background" Value="#FF242842" />
                                </Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter TargetName="Segment" Property="Background" Value="#FF244359" />
                                    <Setter Property="Foreground" Value="#FF8DDCFF" />
                                    <Setter Property="FontWeight" Value="SemiBold" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>
    <DockPanel Margin="8">
        <StackPanel DockPanel.Dock="Top">
            <DockPanel Margin="0,0,0,8">
                <Button x:Name="LibraryToolsButton" DockPanel.Dock="Right" Click="OnOpenLibraryTools"
                        Content="更多 ›" MinHeight="26" Padding="7,2" Foreground="{StaticResource TextSecondaryBrush}"
                        ToolTip="历史战绩、打开作业站" AutomationProperties.Name="更多阵容工具">
                    <Button.ContextMenu>
                        <ContextMenu Placement="Bottom" Style="{StaticResource PanelPagesMenu}">
                            <MenuItem x:Name="HistoryButton" Header="历史战绩" Click="OnHistory" />
                            <MenuItem x:Name="OpenLineupHubButton" Header="打开作业站" Click="OnOpenLineupHub"
                                      ToolTip="在浏览器中打开卫戍阵容库" />
                        </ContextMenu>
                    </Button.ContextMenu>
                </Button>
                <TextBlock x:Name="PageHeading" Text="阵容" VerticalAlignment="Center" Style="{StaticResource SidebarPageTitle}" />
            </DockPanel>
            <UniformGrid Columns="2" Margin="0,0,0,8">
                <Button x:Name="NewButton" Content="＋ 新建阵容" Click="OnNew" Margin="0,0,3,0" FontSize="13"
                        AutomationProperties.Name="新建阵容" MinHeight="32" Padding="6,3"
                        Background="#FF23465D" BorderBrush="#FF3784A7" Foreground="#FFBBEBFF" FontWeight="SemiBold" />
                <Button x:Name="ImportClipboardButton" Content="剪贴板导入" Click="OnImportClipboard" Margin="3,0,0,0"
                        FontSize="13" MinHeight="32" Padding="6,3" ToolTip="从剪贴板导入阵容分享文本或卫戍阵容库短链接" />
            </UniformGrid>
            <Border Style="{StaticResource SidebarSurface}" Padding="2" Margin="0,0,0,8">
                <ListBox x:Name="CategoryTabs" SelectedIndex="0" SelectionChanged="OnCategoryChanged"
                         ItemContainerStyle="{StaticResource CategorySegment}" AutomationProperties.Name="阵容分类">
                    <ListBox.Template>
                        <ControlTemplate TargetType="ListBox"><ItemsPresenter /></ControlTemplate>
                    </ListBox.Template>
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate><UniformGrid Columns="3" /></ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBoxItem Content="全部阵容" />
                    <ListBoxItem Content="我的阵容" />
                    <ListBoxItem Content="导入阵容" />
                </ListBox>
            </Border>
            <TextBlock Text="{Binding Status}" AutomationProperties.LiveSetting="Polite"
                       Foreground="#FFFFCA80" TextWrapping="Wrap" Margin="0,0,0,8">
                <TextBlock.Style>
                    <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Status}" Value="">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Status}" Value="{x:Null}">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
            <Button x:Name="UploadedLineupButton" Content="查看已上传阵容" Click="OnOpenUploadedLineup"
                    HorizontalAlignment="Left" Visibility="Collapsed" Margin="0,0,0,8" />
            <DockPanel Margin="0,0,0,6">
                <TextBlock DockPanel.Dock="Right" Text="{Binding Items.Count, ElementName=LineupCards, StringFormat={}{0} 套}"
                           VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" />
                <TextBlock Text="阵容列表" Style="{StaticResource SidebarSectionLabel}" VerticalAlignment="Center" />
            </DockPanel>
        </StackPanel>
        <Grid>
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <!-- Use the alternation index as the visible card index without wrapping. -->
                <ItemsControl x:Name="LineupCards" ItemsSource="{Binding Source={StaticResource FilteredLineups}}"
                              AlternationCount="2147483647">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource SidebarSurface}" Padding="10" Margin="0,0,0,8">
                                <Border.ContextMenu>
                                    <ContextMenu Style="{StaticResource PanelPagesMenu}"
                                                 DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                                        <MenuItem Header="编辑阵容" Click="OnEdit" />
                                        <MenuItem Header="删除阵容" Click="OnDelete" />
                                    </ContextMenu>
                                </Border.ContextMenu>
                                <StackPanel>
                                    <TextBlock Text="{Binding Name}" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap"
                                               Foreground="{StaticResource TextPrimaryBrush}" />
                                    <DockPanel Margin="0,3,0,2">
                                        <TextBlock DockPanel.Dock="Right" Text="{Binding Members.Count, StringFormat={}{0} 名干员}" Margin="6,0,0,0"
                                                   Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" />
                                        <TextBlock Text="{Binding Author, StringFormat=作者：{0}}" ToolTip="{Binding Author}" TextTrimming="CharacterEllipsis"
                                                   Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" />
                                    </DockPanel>
                                    <TextBlock Text="{Binding CovenantTagSummary}" Foreground="{StaticResource AccentBrush}" TextWrapping="Wrap">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding CovenantTagSummary}" Value="">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <ContentControl x:Name="ActiveCovenantList" Focusable="False" IsTabStop="False">
                                        <ContentControl.Content>
                                            <MultiBinding Converter="{StaticResource LineupActiveCovenants}">
                                                <Binding />
                                                <Binding Path="CovenantAvailability" RelativeSource="{RelativeSource AncestorType=views:LineupView}" />
                                            </MultiBinding>
                                        </ContentControl.Content>
                                    </ContentControl>
                                    <ItemsControl ItemsSource="{Binding Members}" Margin="0,8,0,5">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border x:Name="PortraitTile" Width="40" Height="40" Margin="0,0,5,5"
                                                        CornerRadius="4" Background="#FF12122A"
                                                        AutomationProperties.Name="{Binding OperatorName}">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="ToolTip" Value="{Binding OperatorName}" />
                                                        </Style>
                                                    </Border.Style>
                                                    <Grid>
                                                        <Image x:Name="Portrait" Stretch="Uniform" Loaded="OnPortraitLoaded"
                                                               DataContextChanged="OnPortraitMemberChanged" />
                                                        <TextBlock x:Name="PortraitFallback" Text="{Binding OperatorName}" Visibility="Collapsed"
                                                                   Foreground="{StaticResource TextPrimaryBrush}"
                                                                   TextAlignment="Center" TextWrapping="Wrap" TextTrimming="CharacterEllipsis"
                                                                   VerticalAlignment="Center" FontSize="10" Margin="2" />
                                                        <Border x:Name="PortraitBanOverlay" CornerRadius="4" Background="#55000000"
                                                                Visibility="Collapsed" IsHitTestVisible="False">
                                                            <Grid>
                                                                <Path Data="M 5,35 L 35,5" Stroke="#DF22121D" StrokeThickness="6"
                                                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                                                                <Path Data="M 5,35 L 35,5" Stroke="#FFFF767E" StrokeThickness="3"
                                                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                                                            </Grid>
                                                        </Border>
                                                    </Grid>
                                                </Border>
                                                <DataTemplate.Triggers>
                                                    <DataTrigger Binding="{Binding Source, ElementName=Portrait}" Value="{x:Null}">
                                                        <Setter TargetName="PortraitFallback" Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding (controls:DeferredIcon.IsGrayscale), ElementName=Portrait}" Value="True">
                                                        <Setter TargetName="PortraitBanOverlay" Property="Visibility" Value="Visible" />
                                                        <Setter TargetName="PortraitTile" Property="ToolTip"
                                                                Value="{Binding Path=(AutomationProperties.HelpText), RelativeSource={RelativeSource Self}}" />
                                                        <Setter TargetName="PortraitTile" Property="AutomationProperties.HelpText"
                                                                Value="{Binding OperatorName, StringFormat='{}{0} · 本局禁用'}" />
                                                    </DataTrigger>
                                                </DataTemplate.Triggers>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <StackPanel Margin="0,0,0,8">
                                        <StackPanel.Style>
                                            <Style TargetType="StackPanel">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding AvailableStrategies.Count}" Value="0">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </StackPanel.Style>
                                        <TextBlock Text="可用策略" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" Margin="0,0,0,4" />
                                        <ItemsControl x:Name="StrategyStrip"
                                                      ItemsSource="{Binding AvailableStrategies, Converter={StaticResource StrategyCardPortraits}}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Width="28" Height="28" Margin="0,0,4,4" CornerRadius="4"
                                                            Background="#FF12122A" ToolTip="{Binding Label}"
                                                            AutomationProperties.Name="{Binding Label}">
                                                        <Grid>
                                                            <Image x:Name="StrategyPortrait" Stretch="Uniform"
                                                                   controls:DeferredIcon.Path="{Binding IconPath}" />
                                                            <TextBlock x:Name="StrategyFallback" Text="{Binding Text}" Visibility="Collapsed"
                                                                       Foreground="{StaticResource TextPrimaryBrush}"
                                                                       TextAlignment="Center" TextWrapping="Wrap" TextTrimming="CharacterEllipsis"
                                                                       VerticalAlignment="Center" FontSize="9" Margin="1" />
                                                        </Grid>
                                                    </Border>
                                                    <DataTemplate.Triggers>
                                                        <DataTrigger Binding="{Binding Source, ElementName=StrategyPortrait}" Value="{x:Null}">
                                                            <Setter TargetName="StrategyFallback" Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </DataTemplate.Triggers>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                    <UniformGrid Columns="3">
                                        <Button Click="OnPreview" Style="{StaticResource LineupCardAction}" Margin="0,0,3,0"
                                                AutomationProperties.Name="预览">
                                            <StackPanel Orientation="Horizontal">
                                                <Path Style="{StaticResource LineupCardActionIcon}" Data="{StaticResource LineupPreviewIcon}" />
                                                <TextBlock Text="预览" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                            </StackPanel>
                                        </Button>
                                        <Button Click="OnTrackLineup" Margin="1,0,2,0"
                                                AutomationProperties.Name="{Binding Content, RelativeSource={RelativeSource Self}}">
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource LineupCardAction}">
                                                    <Setter Property="Content" Value="追踪" />
                                                    <Style.Triggers>
                                                        <DataTrigger Value="True">
                                                            <DataTrigger.Binding>
                                                                <MultiBinding Converter="{StaticResource LineupTracking}">
                                                                    <Binding />
                                                                    <Binding Path="Tracking" RelativeSource="{RelativeSource AncestorType=views:LineupView}" />
                                                                    <!-- Reevaluate when operators are added or removed. -->
                                                                    <Binding Path="Tracking.TrackedOperators.Count" RelativeSource="{RelativeSource AncestorType=views:LineupView}" />
                                                                </MultiBinding>
                                                            </DataTrigger.Binding>
                                                            <Setter Property="Content" Value="追踪中" />
                                                            <Setter Property="Tag" Value="tracked" />
                                                            <Setter Property="ToolTip" Value="再次点击取消该阵容的追踪" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                            <Button.ContentTemplate>
                                                <DataTemplate>
                                                    <StackPanel Orientation="Horizontal">
                                                        <Path Style="{StaticResource LineupCardActionIcon}" Data="{StaticResource LineupTrackIcon}" />
                                                        <TextBlock Text="{Binding}" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                                    </StackPanel>
                                                </DataTemplate>
                                            </Button.ContentTemplate>
                                        </Button>
                                        <ToggleButton x:Name="ManageLineup" AutomationProperties.Name="管理阵容"
                                                      ToolTip="分享、上传、编辑、删除和排序" Margin="2,0,0,0" MinHeight="28"
                                                      FontSize="12" Padding="3,3" Style="{StaticResource VariantToggleButton}">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="管理" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}" />
                                                <Path Width="8" Height="5" Stretch="Fill" Margin="5,0,0,0" VerticalAlignment="Center"
                                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}"
                                                      StrokeThickness="1.3" Data="M 1,1 L 5,5 9,1" RenderTransformOrigin=".5,.5">
                                                    <Path.Style>
                                                        <Style TargetType="Path">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsChecked, ElementName=ManageLineup}" Value="True">
                                                                    <Setter Property="RenderTransform"><Setter.Value><RotateTransform Angle="180" /></Setter.Value></Setter>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Path.Style>
                                                </Path>
                                            </StackPanel>
                                        </ToggleButton>
                                    </UniformGrid>
                                    <StackPanel x:Name="ManagementActions" Margin="0,6,0,0"
                                                Visibility="{Binding IsChecked, ElementName=ManageLineup, Converter={StaticResource ShowWhenChecked}}">
                                      <UniformGrid Columns="4">
                                        <Button Content="分享" Click="OnSharePublicLink" Style="{StaticResource LineupCardAction}"
                                                AutomationProperties.Name="分享" Margin="0,0,3,0"
                                                ToolTip="复制阵容短链接，持链接者可在 90 天内查看或导入" />
                                        <Button Content="上传" Click="OnUpload" AutomationProperties.Name="上传" Margin="1,0,2,0"
                                                ToolTipService.ShowOnDisabled="True">
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource LineupCardAction}">
                                                    <Setter Property="ToolTip" Value="上传到卫戍阵容库" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsImported}" Value="True">
                                                            <Setter Property="IsEnabled" Value="False" />
                                                            <Setter Property="ToolTip" Value="导入的阵容可分享，不能上传为自己的阵容" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                        <Button Content="编辑" Click="OnEdit" Style="{StaticResource LineupCardAction}"
                                                AutomationProperties.Name="编辑" Margin="2,0,1,0" />
                                        <Button Content="删除" Click="OnDelete" Style="{StaticResource LineupCardAction}"
                                                AutomationProperties.Name="删除" Margin="3,0,0,0" />
                                      </UniformGrid>
                                      <UniformGrid Columns="3" Margin="0,4,0,0">
                                        <Button Content="上移" AutomationProperties.Name="上移" Tag="{x:Static viewModels:LineupMove.Up}"
                                                Click="OnMoveLineup" Style="{StaticResource LineupMoveAction}" Margin="0,0,3,0" />
                                        <Button Content="下移" AutomationProperties.Name="下移" Tag="{x:Static viewModels:LineupMove.Down}"
                                                Click="OnMoveLineup" Style="{StaticResource LineupMoveAction}" Margin="1,0,2,0" />
                                        <Button Content="置顶" AutomationProperties.Name="置顶" Tag="{x:Static viewModels:LineupMove.Top}"
                                                Click="OnMoveLineup" Style="{StaticResource LineupMoveAction}" Margin="2,0,0,0" />
                                      </UniformGrid>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
            <Border Padding="14,18" VerticalAlignment="Top">
                <Border.Style>
                    <Style TargetType="Border" BasedOn="{StaticResource SidebarSurface}">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasItems, ElementName=LineupCards}" Value="False">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel>
                    <TextBlock Text="此分类暂无阵容" FontSize="14" FontWeight="SemiBold" />
                    <TextBlock Margin="0,5,0,0" TextWrapping="Wrap" Foreground="{StaticResource TextSecondaryBrush}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                <Setter Property="Text" Value="新建一套阵容，或从剪贴板导入分享内容。" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedIndex, ElementName=CategoryTabs}" Value="1">
                                        <Setter Property="Text" Value="点击「新建阵容」开始编排自己的队伍。" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding SelectedIndex, ElementName=CategoryTabs}" Value="2">
                                        <Setter Property="Text" Value="复制分享文本或短链接，再点击「剪贴板导入」。" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </Border>
        </Grid>
    </DockPanel>
</UserControl>
