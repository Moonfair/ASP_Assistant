<UserControl x:Class="ASPAssistant.App.Views.TrackingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:ASPAssistant.App.Controls"
             Background="{StaticResource PanelBackgroundBrush}">
    <UserControl.Resources>
        <DataTemplate x:Key="TrackingItemTemplate">
            <Border Style="{StaticResource ItemCardBorder}" Padding="4">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="✕" Padding="4,2" Margin="4,0,0,0"
                            VerticalAlignment="Center" Style="{StaticResource TrackingButton}"
                            Click="OnRemoveTracking" ToolTip="取消追踪" AutomationProperties.Name="取消追踪" />
                    <Image DockPanel.Dock="Left" Width="24" Height="24" Margin="0,0,4,0"
                           Stretch="Uniform" controls:DeferredIcon.Path="{Binding IconPath}" />
                    <TextBlock Text="{Binding Name}" Foreground="{StaticResource TextPrimaryBrush}"
                               FontSize="12" TextWrapping="Wrap" VerticalAlignment="Center" />
                </DockPanel>
            </Border>
        </DataTemplate>
    </UserControl.Resources>
    <DockPanel Margin="8">
        <Button DockPanel.Dock="Top" Content="取消所有" HorizontalAlignment="Right" Margin="0,0,0,8"
                Click="OnClearTracking">
            <Button.Style>
                <Style TargetType="Button" BasedOn="{StaticResource TrackingButton}">
                    <Style.Triggers>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding TrackedOperators.Count}" Value="0" />
                                <Condition Binding="{Binding TrackedEquipment.Count}" Value="0" />
                            </MultiDataTrigger.Conditions>
                            <Setter Property="IsEnabled" Value="False" />
                            <Setter Property="Opacity" Value="0.5" />
                        </MultiDataTrigger>
                    </Style.Triggers>
                </Style>
            </Button.Style>
        </Button>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock FontSize="12" FontWeight="Bold" Margin="0,0,0,4"
                               Foreground="{StaticResource TextPrimaryBrush}">
                        <Run Text="追踪中的干员 (" /><Run Text="{Binding TrackedOperators.Count, Mode=OneWay}" /><Run Text=")" />
                    </TextBlock>
                    <ItemsControl ItemsSource="{Binding TrackedOperators}" ItemTemplate="{StaticResource TrackingItemTemplate}" />
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock FontSize="12" FontWeight="Bold" Margin="0,0,0,4"
                               Foreground="{StaticResource TextPrimaryBrush}">
                        <Run Text="追踪中的装备 (" /><Run Text="{Binding TrackedEquipment.Count, Mode=OneWay}" /><Run Text=")" />
                    </TextBlock>
                    <ItemsControl ItemsSource="{Binding TrackedEquipment}" ItemTemplate="{StaticResource TrackingItemTemplate}" />
                </StackPanel>
            </Grid>
        </ScrollViewer>
    </DockPanel>
</UserControl>
