<UserControl x:Class="ASPAssistant.App.Views.BattleDataView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:ASPAssistant.App.Controls"
             Background="{DynamicResource PanelBackgroundBrush}">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../Resources/Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <Style x:Key="Caption" TargetType="TextBlock">
                <Setter Property="FontSize" Value="11" />
                <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid Margin="10,12,10,6">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <DockPanel>
            <TextBlock x:Name="GameClock" DockPanel.Dock="Right" Margin="8,0,0,0"
                       Foreground="{StaticResource TextSecondaryBrush}" ToolTip="回合内游戏时间"
                       Typography.NumeralAlignment="Tabular" VerticalAlignment="Center" />
            <TextBlock x:Name="FeedStatus" Text="等待官方 PC 客户端" TextWrapping="Wrap"
                       Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" />
        </DockPanel>
        <Button x:Name="ConnectButton" Grid.Row="1" Visibility="Collapsed" HorizontalAlignment="Left"
                Style="{StaticResource TrackingButton}" Margin="0,10,0,0" Padding="9,5" Click="OnConnect" />
        <Border x:Name="BossSummary" Grid.Row="2" Margin="0,10,0,0" Padding="0,0,0,8"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Visibility="Collapsed">
            <StackPanel>
                <DockPanel Margin="0,0,0,4">
                    <TextBlock Text="占领袖血量" DockPanel.Dock="Right" Style="{StaticResource Caption}"
                               ToolTip="个人干员对领袖的累计伤害 ÷ 领袖总血量，与游戏榜单一样取整，不是全场伤害占比。" />
                    <TextBlock Text="对领袖伤害" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
                </DockPanel>
                <TextBlock x:Name="BossPending" Text="等待领袖伤害数据" Style="{StaticResource Caption}" />
                <ItemsControl x:Name="BossRows">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,2" ToolTip="{Binding Details}" AutomationProperties.Name="{Binding Details}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" /><ColumnDefinition Width="70" /><ColumnDefinition Width="44" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" Foreground="{StaticResource TextPrimaryBrush}" />
                                    <TextBlock Text="{Binding Player}" TextTrimming="CharacterEllipsis" Style="{StaticResource Caption}" />
                                </StackPanel>
                                <TextBlock Grid.Column="1" Text="{Binding Damage}" VerticalAlignment="Center" TextAlignment="Right"
                                           Foreground="{StaticResource TextPrimaryBrush}" Typography.NumeralAlignment="Tabular" />
                                <TextBlock Grid.Column="2" Text="{Binding Percent}" VerticalAlignment="Center" TextAlignment="Right"
                                           Foreground="{StaticResource AccentBrush}" Typography.NumeralAlignment="Tabular" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>
        <StackPanel x:Name="Summary" Grid.Row="3" Margin="0,12,0,0" Visibility="Collapsed">
            <TextBlock Text="全局伤害 · 干员总伤害" Style="{StaticResource Caption}" />
            <TextBlock x:Name="TotalDamage" FontSize="25" FontWeight="SemiBold" Margin="0,0,0,9"
                       Foreground="{StaticResource TextPrimaryBrush}" Typography.NumeralAlignment="Tabular" />
            <Grid Margin="0,0,0,5">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" /><ColumnDefinition Width="70" /><ColumnDefinition Width="64" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="干员" Style="{StaticResource Caption}" />
                <TextBlock Grid.Column="1" Text="累计伤害" Style="{StaticResource Caption}" TextAlignment="Right" />
                <TextBlock Grid.Column="2" Text="伤害占比" Style="{StaticResource Caption}" TextAlignment="Right"
                           ToolTip="该干员累计伤害占本回合干员总伤害的百分比" />
            </Grid>
        </StackPanel>
        <ScrollViewer x:Name="RowsScroll" Grid.Row="4" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <ItemsControl x:Name="OperatorRows">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="0,5"
                                ToolTip="{Binding Details}" AutomationProperties.Name="{Binding Details}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" /><ColumnDefinition Width="70" /><ColumnDefinition Width="64" />
                                </Grid.ColumnDefinitions>
                                <DockPanel Margin="0,0,4,0">
                                    <Grid DockPanel.Dock="Left" Width="26" Height="26" Margin="0,0,5,0" VerticalAlignment="Center">
                                        <Border Background="{StaticResource CardBackgroundBrush}" CornerRadius="3" />
                                        <Path x:Name="UnknownPortrait" Visibility="Collapsed" Width="14" Height="16" Stretch="Uniform"
                                              Fill="{StaticResource TextSecondaryBrush}" Data="M8,0 A4,4 0 1 1 7.99,0 Z M1,16 V14 A7,6 0 0 1 15,14 V16 Z" />
                                        <Image x:Name="Portrait" controls:DeferredIcon.Path="{Binding IconPath}" Stretch="Uniform"
                                               RenderOptions.BitmapScalingMode="HighQuality" />
                                    </Grid>
                                    <StackPanel VerticalAlignment="Center">
                                        <DockPanel>
                                            <TextBlock DockPanel.Dock="Right" Text="{Binding Instance}" Foreground="{StaticResource TextSecondaryBrush}"
                                                       FontSize="11" VerticalAlignment="Center" />
                                            <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" Foreground="{StaticResource TextPrimaryBrush}" />
                                        </DockPanel>
                                        <ProgressBar Value="{Binding DamageShare, Mode=OneWay}" Maximum="1" Height="2" Margin="0,4,0,0"
                                                     BorderThickness="0" Foreground="{StaticResource AccentBrush}" Background="{StaticResource CardBackgroundBrush}" />
                                    </StackPanel>
                                </DockPanel>
                                <TextBlock Grid.Column="1" Text="{Binding Damage}" TextAlignment="Right" VerticalAlignment="Center"
                                           Typography.NumeralAlignment="Tabular" Foreground="{StaticResource TextPrimaryBrush}" />
                                <TextBlock Grid.Column="2" Text="{Binding DamageShare, StringFormat={}{0:0.00%}}" TextAlignment="Right" VerticalAlignment="Center"
                                           Typography.NumeralAlignment="Tabular" Foreground="{StaticResource AccentBrush}" />
                            </Grid>
                        </Border>
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding Source, ElementName=Portrait}" Value="{x:Null}">
                                <Setter TargetName="UnknownPortrait" Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>
