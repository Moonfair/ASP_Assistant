<UserControl x:Class="ASPAssistant.App.Views.BattleDataView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:ASPAssistant.App.Controls"
             Background="{DynamicResource PanelBackgroundBrush}">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../Resources/Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <Style x:Key="MetricCaption" TargetType="TextBlock">
                <Setter Property="FontSize" Value="11" />
                <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
            </Style>
            <Style x:Key="DamageValue" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="TextAlignment" Value="Right" />
                <Setter Property="Typography.NumeralAlignment" Value="Tabular" />
                <Setter Property="Margin" Value="8,0,0,0" />
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <TextBlock x:Name="PageHeading" Text="战斗数据" Style="{StaticResource SidebarPageTitle}" Margin="0,0,0,3" />
        <StackPanel Grid.Row="1" Margin="0,0,0,8">
            <TextBlock x:Name="FeedStatus" Text="等待官方 PC 客户端" TextWrapping="Wrap"
                       Foreground="{StaticResource TextPrimaryBrush}" AutomationProperties.LiveSetting="Polite" />
            <Button x:Name="ConnectButton" Visibility="Collapsed" HorizontalAlignment="Left"
                    Style="{StaticResource TrackingButton}" Margin="0,6,0,0" Padding="9,5" Click="OnConnect" />
        </StackPanel>
        <ScrollViewer x:Name="RowsScroll" Grid.Row="2" VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <StackPanel Grid.IsSharedSizeScope="True">
                <Border x:Name="BossSummary" Margin="0,0,0,8" Padding="0,0,0,8"
                        BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Visibility="Collapsed">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,4">
                            <TextBlock Text="占领袖血量" DockPanel.Dock="Right" Style="{StaticResource MetricCaption}"
                                       ToolTip="个人干员对领袖的累计伤害 ÷ 领袖总血量，与游戏榜单一样取整，不是全场伤害占比。" />
                            <TextBlock Text="对领袖伤害" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
                        </DockPanel>
                        <TextBlock x:Name="BossPending" Text="等待领袖伤害数据" Style="{StaticResource MetricCaption}" />
                        <ItemsControl x:Name="BossRows">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,2" ToolTip="{Binding Details}" AutomationProperties.Name="{Binding Details}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" /><ColumnDefinition Width="70" /><ColumnDefinition Width="44" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" Foreground="{StaticResource TextPrimaryBrush}" />
                                            <TextBlock Text="{Binding Player}" TextTrimming="CharacterEllipsis" Style="{StaticResource MetricCaption}" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="1" Text="{Binding Damage}" VerticalAlignment="Center" TextAlignment="Right"
                                                   Foreground="{StaticResource TextPrimaryBrush}" Typography.NumeralAlignment="Tabular" />
                                        <TextBlock Grid.Column="2" Text="{Binding Percent}" VerticalAlignment="Center" TextAlignment="Right"
                                                   Foreground="{StaticResource AccentBrush}" Typography.NumeralAlignment="Tabular" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource SidebarSurface}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,8,0">
                            <TextBlock Text="全局伤害 · 干员总伤害" Style="{StaticResource MetricCaption}" />
                            <TextBlock x:Name="TotalDamage" Text="—" FontSize="23" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis"
                                       ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"
                                       Typography.NumeralAlignment="Tabular" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                            <TextBlock Text="回合用时" TextAlignment="Right" Style="{StaticResource MetricCaption}" />
                            <Grid Margin="0,4,0,0">
                                <TextBlock x:Name="GameClock" ToolTip="回合内游戏时间"
                                           Style="{StaticResource DamageValue}" FontSize="16" />
                                <TextBlock Text="—" FontSize="16" AutomationProperties.Name="尚无回合用时">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource DamageValue}">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Text, ElementName=GameClock}" Value="">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>
                        </StackPanel>
                    </Grid>
                </Border>
                <StackPanel x:Name="Summary" Visibility="Collapsed" Margin="0,12,0,0">
                    <TextBlock Text="伤害明细" Style="{StaticResource SidebarSectionLabel}" Margin="0,0,0,5" />
                    <Grid Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" SharedSizeGroup="Amount" />
                            <ColumnDefinition Width="Auto" SharedSizeGroup="Share" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="干员" Style="{StaticResource MetricCaption}" />
                        <TextBlock Grid.Column="1" Text="累计伤害" Margin="8,0,0,0" Style="{StaticResource MetricCaption}" TextAlignment="Right" />
                        <TextBlock Grid.Column="2" Text="伤害占比" Margin="8,0,0,0" Style="{StaticResource MetricCaption}" TextAlignment="Right"
                                   ToolTip="该干员累计伤害占本回合干员总伤害的百分比" />
                    </Grid>
                    <ItemsControl x:Name="OperatorRows" HorizontalContentAlignment="Stretch">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="0,7"
                                        ToolTip="{Binding Details}" AutomationProperties.Name="{Binding Details}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" SharedSizeGroup="Amount" />
                                            <ColumnDefinition Width="Auto" SharedSizeGroup="Share" />
                                        </Grid.ColumnDefinitions>
                                        <DockPanel Margin="0,0,4,0">
                                            <Grid DockPanel.Dock="Left" Width="26" Height="26" Margin="0,0,5,0" VerticalAlignment="Center">
                                                <Border Background="{StaticResource CardBackgroundBrush}" CornerRadius="3" />
                                                <Path x:Name="UnknownPortrait" Visibility="Collapsed" Width="14" Height="16" Stretch="Uniform"
                                                      Fill="{StaticResource TextSecondaryBrush}" Data="M8,0 A4,4 0 1 1 7.99,0 Z M1,16 V14 A7,6 0 0 1 15,14 V16 Z" />
                                                <Image x:Name="Portrait" controls:DeferredIcon.Path="{Binding IconPath}" Stretch="Uniform"
                                                       RenderOptions.BitmapScalingMode="HighQuality" />
                                            </Grid>
                                            <StackPanel VerticalAlignment="Center">
                                                <DockPanel>
                                                    <TextBlock DockPanel.Dock="Right" Text="{Binding Instance}" Foreground="{StaticResource TextSecondaryBrush}"
                                                               FontSize="11" VerticalAlignment="Center" />
                                                    <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" Foreground="{StaticResource TextPrimaryBrush}" />
                                                </DockPanel>
                                                <ProgressBar Value="{Binding DamageShare, Mode=OneWay}" Maximum="1" Height="2" Margin="0,4,0,0"
                                                             BorderThickness="0" Foreground="{StaticResource AccentBrush}" Background="{StaticResource CardBackgroundBrush}" />
                                            </StackPanel>
                                        </DockPanel>
                                        <TextBlock Grid.Column="1" Text="{Binding Damage}" Style="{StaticResource DamageValue}" />
                                        <TextBlock Grid.Column="2" Text="{Binding DamageShare, StringFormat={}{0:0.00%}}" Style="{StaticResource DamageValue}" />
                                    </Grid>
                                </Border>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding Source, ElementName=Portrait}" Value="{x:Null}">
                                        <Setter TargetName="UnknownPortrait" Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
