<UserControl x:Class="ASPAssistant.App.Views.QuickChatPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="Microsoft YaHei UI" FontSize="12">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../Resources/LineupStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <Style x:Key="Caption" TargetType="TextBlock">
                <Setter Property="FontSize" Value="11" />
                <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>
            <Style x:Key="PickField" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="Padding" Value="8,5" />
                <Setter Property="MinHeight" Value="30" />
                <!-- The shared action template centers its content. Fields need the name
                     aligned left and the affordance anchored at the far edge. -->
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Field" Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="4"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Field" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                </Trigger>
                                <Trigger Property="Tag" Value="tracked">
                                    <Setter TargetName="Field" Property="Background" Value="#224FC3F7" />
                                    <Setter TargetName="Field" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.72" /></Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style x:Key="SendAction" TargetType="Button">
                <Setter Property="Padding" Value="11,6" />
                <Setter Property="MinHeight" Value="32" />
                <Setter Property="Foreground" Value="#131D2B" />
                <Setter Property="Background" Value="{StaticResource AccentBrush}" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Surface" Background="{TemplateBinding Background}" CornerRadius="4"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Background" Value="#81D4FA" /></Trigger>
                                <Trigger Property="IsPressed" Value="True"><Setter TargetName="Surface" Property="Opacity" Value="0.8" /></Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="Surface" Property="Background" Value="{StaticResource BorderBrush}" />
                                    <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>
    <Border Style="{StaticResource ItemCardBorder}" Padding="10,9" Margin="0,5,0,9">
        <StackPanel>
            <DockPanel Margin="0,0,0,8">
                <TextBlock DockPanel.Dock="Right" Text="队伍频道" Style="{StaticResource Caption}" />
                <StackPanel Orientation="Horizontal">
                    <Path Width="16" Height="16" Margin="0,0,6,0" Stretch="Uniform" VerticalAlignment="Center"
                          Stroke="{StaticResource AccentBrush}" StrokeThickness="1.5" StrokeLineJoin="Round"
                          Data="M2,2 L16,2 Q18,2 18,4 L18,11 Q18,13 16,13 L8,13 L3,17 L3,13 L2,13 Q1,13 1,11 L1,4 Q1,2 2,2 Z M5,6 L14,6 M5,9 L11,9" />
                    <TextBlock Text="快捷喊话" FontSize="16" FontWeight="SemiBold" />
                </StackPanel>
            </DockPanel>

            <Border x:Name="FeedPanel" Visibility="Collapsed" Background="{StaticResource PanelBackgroundBrush}"
                    BorderBrush="{StaticResource AccentBrush}" BorderThickness="2,0,0,0" Padding="8,5" Margin="0,0,0,8">
                <ItemsControl x:Name="Feed" AutomationProperties.Name="队内喊话" AutomationProperties.LiveSetting="Polite">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock TextWrapping="Wrap" Margin="0,1" FontSize="12"><Run Text="{Binding Sender, Mode=OneWay}" Foreground="{StaticResource AccentBrush}"/><Run Text="  "/><Run Text="{Binding Text, Mode=OneWay}"/></TextBlock>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Border>

            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="40" /><ColumnDefinition /></Grid.ColumnDefinitions>
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                <TextBlock Text="句式" Style="{StaticResource Caption}" />
                <Button x:Name="PickTemplate" Grid.Column="1" Style="{StaticResource PickField}" Click="OnPickTemplate" AutomationProperties.Name="选择句式">
                    <DockPanel><Path DockPanel.Dock="Right" Width="8" Height="5" Margin="6,0,0,0" VerticalAlignment="Center" Stretch="Uniform" Stroke="{StaticResource AccentBrush}" StrokeThickness="1.5" Data="M0,0 L4,4 L8,0"/><TextBlock x:Name="TemplateLabel" TextTrimming="CharacterEllipsis" /></DockPanel>
                </Button>
                <TextBlock Grid.Row="1" Text="填词" Style="{StaticResource Caption}" Margin="0,5,0,0" />
                <Button x:Name="PickWord" Grid.Row="1" Grid.Column="1" Style="{StaticResource PickField}" Margin="0,5,0,0"
                        Click="OnPickWord" AutomationProperties.Name="选择填入的词汇">
                    <DockPanel><Path DockPanel.Dock="Right" Width="8" Height="5" Margin="6,0,0,0" VerticalAlignment="Center" Stretch="Uniform" Stroke="{StaticResource AccentBrush}" StrokeThickness="1.5" Data="M0,0 L4,4 L8,0"/><TextBlock x:Name="WordLabel" Text="选择词汇" TextTrimming="CharacterEllipsis" /></DockPanel>
                </Button>
            </Grid>
            <Border x:Name="Chooser" Visibility="Collapsed" Background="{StaticResource PanelBackgroundBrush}"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="4" Margin="0,6,0,0" Padding="6">
                <StackPanel>
                    <Grid>
                        <TextBox x:Name="Query" Padding="25,4,5,4" MinHeight="27" MaxLength="80" TextChanged="OnQuery" PreviewKeyDown="OnQueryKey"/>
                        <Path Width="12" Height="12" Stretch="Uniform" VerticalAlignment="Center" Margin="7,0,0,0" HorizontalAlignment="Left"
                              Stroke="{StaticResource TextSecondaryBrush}" StrokeThickness="1.5" IsHitTestVisible="False"
                              Data="M10.5,6 A4.5,4.5 0 1 1 1.5,6 A4.5,4.5 0 1 1 10.5,6 M9.5,9.5 L14,14" />
                        <TextBlock x:Name="QueryHint" Style="{StaticResource Caption}" Margin="26,0,0,0" IsHitTestVisible="False" />
                    </Grid>
                    <ListBox x:Name="Types" BorderThickness="0" Background="Transparent" Margin="0,6,0,1" Padding="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Disabled"
                             AutomationProperties.Name="按类型筛选" ItemContainerStyle="{StaticResource FilterChipItem}" SelectionChanged="OnTypeChanged">
                        <ListBox.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ListBox.ItemsPanel>
                    </ListBox>
                    <Grid>
                        <ListBox x:Name="Results" MaxHeight="112" Background="Transparent" BorderThickness="0" Padding="0"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto"
                                 VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                                 AutomationProperties.Name="匹配结果" PreviewMouseLeftButtonUp="OnResultClick" PreviewKeyDown="OnResultKey">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                                    <Setter Property="Padding" Value="6,4" /><Setter Property="Cursor" Value="Hand" />
                                    <Setter Property="ToolTip" Value="{Binding}" />
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" TextWrapping="Wrap"/></DataTemplate></ListBox.ItemTemplate>
                        </ListBox>
                        <TextBlock x:Name="NoResults" Visibility="Collapsed" Style="{StaticResource Caption}"
                                   Text="无匹配结果，试试更短的关键词。" TextWrapping="Wrap" Margin="5,9" />
                    </Grid>
                </StackPanel>
            </Border>

            <DockPanel Margin="0,9,0,8">
                <Button x:Name="Send" DockPanel.Dock="Right" Content="发送" Click="OnSend" Style="{StaticResource SendAction}"
                        Margin="6,0,0,0" VerticalAlignment="Center" AutomationProperties.Name="发送快捷喊话" />
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="喊话预览" Style="{StaticResource Caption}" />
                    <TextBlock FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,2,0,0"><Run x:Name="Prefix"/><Run x:Name="Slot" Foreground="{StaticResource AccentBrush}"/><Run x:Name="Suffix"/></TextBlock>
                </StackPanel>
            </DockPanel>
            <Border Height="1" Background="{StaticResource BorderBrush}" />
            <DockPanel Margin="0,7,0,4">
                <TextBlock x:Name="HistoryCount" DockPanel.Dock="Right" Style="{StaticResource Caption}" />
                <TextBlock Text="最近发送" FontWeight="SemiBold" />
            </DockPanel>
            <TextBlock x:Name="HistoryEmpty" Text="发出第一条喊话后，可在这里一键重发。" Style="{StaticResource Caption}" TextWrapping="Wrap" />
            <ItemsControl x:Name="History" AutomationProperties.Name="最近发送，点击立即重发">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Style="{StaticResource PickField}" MinHeight="25" Margin="0,0,0,3" Padding="7,3"
                                Click="OnRepeat" IsEnabled="{Binding Available}" ToolTip="{Binding Hint}" ToolTipService.ShowOnDisabled="True">
                            <DockPanel>
                                <Path DockPanel.Dock="Right" Width="11" Height="11" Margin="6,0,0,0" Stretch="Uniform" VerticalAlignment="Center"
                                      Stroke="{StaticResource TextSecondaryBrush}" StrokeThickness="1.4" StrokeLineJoin="Round"
                                      Data="M2,11 L10,11 Q14,11 14,7 L14,6 Q14,3 10,3 L4,3 M7,0 L3,3 L7,6" />
                                <TextBlock Text="{Binding Text}" TextWrapping="Wrap" />
                            </DockPanel>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock x:Name="HistoryNotice" Visibility="Collapsed" Style="{StaticResource Caption}" TextWrapping="Wrap" />
        </StackPanel>
    </Border>
</UserControl>
