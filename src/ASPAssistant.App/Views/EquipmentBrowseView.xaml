<UserControl x:Class="ASPAssistant.App.Views.EquipmentBrowseView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:ASPAssistant.App.Controls"
             xmlns:converters="clr-namespace:ASPAssistant.App.Converters"
             Background="{StaticResource PanelBackgroundBrush}"
             DataContextChanged="OnViewDataContextChanged">
    <UserControl.Resources>
        <converters:NullToStringConverter x:Key="NullToAll" />
    </UserControl.Resources>
    <DockPanel>
        <controls:CatalogSearchBox DockPanel.Dock="Top" Margin="8,8,8,4" Hint="搜索装备名称" />
        <StackPanel x:Name="TopFilterHost" DockPanel.Dock="Top" Margin="8,0,8,4">
            <ToggleButton x:Name="FilterToggle"
                          Foreground="{StaticResource TextSecondaryBrush}"
                          FontSize="12" Padding="0,4,12,4" Cursor="Hand">
                <ToggleButton.Style>
                    <Style TargetType="ToggleButton">
                        <Setter Property="Content" Value="▶ 筛选" />
                        <Setter Property="Background" Value="Transparent" />
                        <Setter Property="BorderThickness" Value="0" />
                        <Setter Property="HorizontalContentAlignment" Value="Left" />
                        <Setter Property="VerticalContentAlignment" Value="Top" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ToggleButton">
                                    <ContentPresenter HorizontalAlignment="Left"
                                                      VerticalAlignment="Top"
                                                      Margin="{TemplateBinding Padding}" />
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                        <Style.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter Property="Content" Value="▼ 筛选" />
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </ToggleButton.Style>
            </ToggleButton>

            <StackPanel x:Name="FilterContentPanel" Margin="0,6,0,2">

                <Expander Header="等阶" Style="{StaticResource FilterSectionExpander}">
                    <ListBox x:Name="TierFilterList"
                             controls:FilterChipSelection.IsEnabled="True"
                             Style="{StaticResource FilterChipListBox}"
                             ItemsSource="{Binding AvailableTiers}"
                             SelectionChanged="OnTierFilterChanged">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Converter={StaticResource NullToAll}, ConverterParameter=全部}"
                                           FontSize="11" />
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Expander>

                <Expander Header="类型" Style="{StaticResource FilterSectionExpander}">
                    <ListBox x:Name="TypeFilterList"
                             controls:FilterChipSelection.IsEnabled="True"
                             Style="{StaticResource FilterChipListBox}"
                             ItemsSource="{Binding AvailableTypes}"
                             SelectionChanged="OnTypeFilterChanged">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Converter={StaticResource NullToAll}, ConverterParameter=全部}"
                                           FontSize="11" />
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Expander>
            </StackPanel>
        </StackPanel>
        <Grid>
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="EquipmentListControl" ItemsSource="{Binding FilteredEquipment}" Margin="8,0,8,8">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <controls:EquipmentCard TrackingToggled="OnEquipmentTrackingToggled" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
            <StackPanel x:Name="NoResults" Margin="12,22" VerticalAlignment="Top" IsHitTestVisible="False">
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasItems, ElementName=EquipmentListControl}" Value="False">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>
                <TextBlock Text="没有匹配的装备" HorizontalAlignment="Center" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
                <TextBlock Text="试试其他名称，或减少筛选条件。" HorizontalAlignment="Center" Margin="0,5,0,0" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" />
            </StackPanel>
        </Grid>
    </DockPanel>
</UserControl>
