<UserControl x:Class="ASPAssistant.App.Views.OperatorBrowseView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:ASPAssistant.App.Controls"
             xmlns:views="clr-namespace:ASPAssistant.App.Views"
             xmlns:converters="clr-namespace:ASPAssistant.App.Converters"
             Background="{StaticResource PanelBackgroundBrush}">
    <UserControl.Resources>
        <converters:NullToStringConverter x:Key="NullToAll" />
        <converters:TierToRomanConverter x:Key="TierLabel" />
        <converters:CovenantDisabledConverter x:Key="CovenantDisabled" />
        <Style x:Key="CoreCovenantFilterChip" TargetType="ListBoxItem" BasedOn="{StaticResource FilterChipItem}">
            <Style.Triggers>
                <DataTrigger Value="True">
                    <DataTrigger.Binding>
                        <MultiBinding Converter="{StaticResource CovenantDisabled}">
                            <Binding />
                            <Binding Path="DataContext.CovenantAvailability.EnabledCore" RelativeSource="{RelativeSource AncestorType=ListBox}" />
                        </MultiBinding>
                    </DataTrigger.Binding>
                    <Setter Property="Opacity" Value="0.5" />
                    <Setter Property="ToolTip" Value="本局禁用" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="AdditionalCovenantFilterChip" TargetType="ListBoxItem" BasedOn="{StaticResource FilterChipItem}">
            <Style.Triggers>
                <DataTrigger Value="True">
                    <DataTrigger.Binding>
                        <MultiBinding Converter="{StaticResource CovenantDisabled}">
                            <Binding />
                            <Binding Path="DataContext.CovenantAvailability.EnabledAdditional" RelativeSource="{RelativeSource AncestorType=ListBox}" />
                        </MultiBinding>
                    </DataTrigger.Binding>
                    <Setter Property="Opacity" Value="0.5" />
                    <Setter Property="ToolTip" Value="本局禁用" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="CovenantGroupLabel" TargetType="TextBlock">
            <Setter Property="DockPanel.Dock" Value="Left" />
            <Setter Property="Width" Value="30" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="Opacity" Value="0.6" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource AncestorType=Expander}}" Value="True">
                    <Setter Property="DockPanel.Dock" Value="Top" />
                    <Setter Property="Width" Value="Auto" />
                    <Setter Property="Margin" Value="0,0,0,5" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>
    <DockPanel>
        <!-- Search box -->
        <Border DockPanel.Dock="Top" Margin="8,8,8,4"
                Background="#FF1E1E38" BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1" CornerRadius="6">
            <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                     Background="Transparent" Foreground="{StaticResource TextPrimaryBrush}"
                     BorderThickness="0" Padding="8,5"
                     CaretBrush="{StaticResource AccentBrush}" />
        </Border>

        <!-- Filter panel: two-row Grid — header row (toggle + tags) above content row (lists).
             No overlay: tags fill the DockPanel remainder, toggle is always protected on the left. -->
        <Grid x:Name="TopFilterHost" DockPanel.Dock="Top" Margin="8,0,8,4">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition x:Name="FilterContentRow" Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Row 0: "筛选" toggle (left) + active filter tag chips (fills right) -->
            <DockPanel Grid.Row="0" LastChildFill="True">
                <ToggleButton x:Name="FilterToggle" DockPanel.Dock="Left"
                              Foreground="{StaticResource TextSecondaryBrush}"
                              FontSize="12" Padding="0,4,12,4" Cursor="Hand">
                    <ToggleButton.Style>
                        <Style TargetType="ToggleButton">
                            <Setter Property="Content" Value="▶ 筛选" />
                            <Setter Property="Background" Value="Transparent" />
                            <Setter Property="BorderThickness" Value="0" />
                            <Setter Property="HorizontalContentAlignment" Value="Left" />
                            <Setter Property="VerticalContentAlignment" Value="Top" />
                            <!-- Custom template: no hover/press color changes -->
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <ContentPresenter HorizontalAlignment="Left"
                                                          VerticalAlignment="Top"
                                                          Margin="{TemplateBinding Padding}" />
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter Property="Content" Value="▼ 筛选" />
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </ToggleButton.Style>
                </ToggleButton>

                <ItemsControl x:Name="FilterTagsControl"
                              ItemsSource="{Binding ActiveFilterTags}"
                              HorizontalAlignment="Right">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel HorizontalAlignment="{Binding HorizontalAlignment, RelativeSource={RelativeSource AncestorType=ItemsControl}}" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Button Content="{Binding Label}" Padding="7,2" Margin="0,0,3,2"
                                        FontSize="11" Cursor="Hand"
                                        Click="OnFilterTagClicked">
                                    <Button.ContentTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal">
                                                <controls:CovenantIcon Covenant="{Binding DataContext, RelativeSource={RelativeSource AncestorType=Button}}"
                                                    Width="13" Height="13" Margin="0,0,4,0" Foreground="{StaticResource AccentBrush}" />
                                                <TextBlock Text="{Binding}" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </Button.ContentTemplate>
                                    <Button.Style>
                                        <Style TargetType="Button">
                                            <Setter Property="Background" Value="#224FC3F7" />
                                            <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
                                            <Setter Property="ToolTip" Value="点击移除此筛选" />
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border Padding="{TemplateBinding Padding}"
                                                                Background="{TemplateBinding Background}"
                                                                BorderBrush="{StaticResource AccentBrush}"
                                                                BorderThickness="1" CornerRadius="10">
                                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                        </Border>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                            <Style.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="#444FC3F7" />
                                                </Trigger>
                                                <Trigger Property="IsPressed" Value="True">
                                                    <Setter Property="Background" Value="#664FC3F7" />
                                                </Trigger>
                                                <DataTrigger Value="True">
                                                    <DataTrigger.Binding>
                                                        <MultiBinding Converter="{StaticResource CovenantDisabled}">
                                                            <Binding />
                                                            <Binding Path="DataContext.CovenantAvailability" RelativeSource="{RelativeSource AncestorType=ItemsControl}" />
                                                        </MultiBinding>
                                                    </DataTrigger.Binding>
                                                    <Setter Property="Opacity" Value="0.5" />
                                                    <Setter Property="ToolTip" Value="本局禁用 · 点击移除此筛选" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsSeparator}" Value="True">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                                <TextBlock Text="|" FontSize="11" Margin="1,0,3,2"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           VerticalAlignment="Center">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsSeparator}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </DockPanel>

            <!-- Row 1: Filter lists — shown only when FilterToggle is checked -->
            <ScrollViewer x:Name="TopFilterScroll" Grid.Row="1" MaxHeight="320" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel x:Name="FilterContentPanel"
                        ClipToBounds="True" Margin="0,6,0,2">

                <StackPanel x:Name="FilterActionsPanel" Margin="0,6,0,6">
                    <WrapPanel><Button x:Name="ClearBansButton"
                            Content="清除ban位" FontSize="11"
                            Padding="8,2" Margin="0,0,6,4"
                            HorizontalAlignment="Right"
                            Click="OnClearBansClicked">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Background" Value="#33DD2222" />
                                <Setter Property="Foreground" Value="#FFDD2222" />
                                <Setter Property="BorderBrush" Value="#55DD2222" />
                                <Setter Property="BorderThickness" Value="1" />
                                <Setter Property="Cursor" Value="Hand" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}"
                                                    BorderBrush="{TemplateBinding BorderBrush}"
                                                    BorderThickness="{TemplateBinding BorderThickness}"
                                                    CornerRadius="4"
                                                    Padding="{TemplateBinding Padding}">
                                                <ContentPresenter HorizontalAlignment="Center"
                                                                  VerticalAlignment="Center" />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="#55DD2222" />
                                                </Trigger>
                                                <Trigger Property="IsPressed" Value="True">
                                                    <Setter Property="Background" Value="#88DD2222" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Button.Style>
                    </Button>
<Button x:Name="ManualScanButton"
                            Content="截屏录入" FontSize="11"
                            Padding="8,2" Margin="0,0,6,4"
                            HorizontalAlignment="Right"
                            Click="OnManualScanClicked">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Background" Value="#334FC3F7" />
                                <Setter Property="Foreground" Value="#FF4FC3F7" />
                                <Setter Property="BorderBrush" Value="#554FC3F7" />
                                <Setter Property="BorderThickness" Value="1" />
                                <Setter Property="Cursor" Value="Hand" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}"
                                                    BorderBrush="{TemplateBinding BorderBrush}"
                                                    BorderThickness="{TemplateBinding BorderThickness}"
                                                    CornerRadius="4"
                                                    Padding="{TemplateBinding Padding}">
                                                <ContentPresenter HorizontalAlignment="Center"
                                                                  VerticalAlignment="Center" />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="#554FC3F7" />
                                                </Trigger>
                                                <Trigger Property="IsPressed" Value="True">
                                                    <Setter Property="Background" Value="#884FC3F7" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Button.Style>
                    </Button></WrapPanel>
                    <TextBlock x:Name="ManualScanStatusText"

                               FontSize="11" VerticalAlignment="Center"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               Margin="4,0,0,0"
                               Visibility="Collapsed" />
                </StackPanel>
                <Expander Header="本局状态" Style="{StaticResource FilterSectionExpander}">
                    <StackPanel><ListBox x:Name="AvailabilityFilterList"
                         Style="{StaticResource FilterChipListBox}"
                         Margin="0,0,0,6"
                         SelectionChanged="OnAvailabilityFilterChanged">
                    <ListBoxItem Content="全部" />
                    <ListBoxItem Content="本局可用" />
                    <ListBoxItem Content="本局不可用" />
                </ListBox></StackPanel>
                </Expander>
                <Expander Header="等阶" Style="{StaticResource FilterSectionExpander}">
                    <StackPanel><ListBox x:Name="TierFilterList"
                         controls:FilterChipSelection.IsEnabled="True"
                         Style="{StaticResource FilterChipListBox}"
                         ItemsSource="{Binding AvailableTiers}"
                         SelectionChanged="OnMultiFilterChanged">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Converter={StaticResource TierLabel}, ConverterParameter=全部}"
                                       FontSize="11" />
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox></StackPanel>
                </Expander>
                <Expander Header="盟约" Style="{StaticResource FilterSectionExpander}">
                    <StackPanel><!-- Core covenants row -->
                <DockPanel Margin="0,0,0,4">
                    <TextBlock Text="核心" Style="{StaticResource CovenantGroupLabel}" />
                    <ListBox x:Name="CoreCovenantFilterList"
                         controls:FilterChipSelection.IsEnabled="True"
                             Style="{StaticResource FilterChipListBox}"
                             ItemsSource="{Binding AvailableCoreCovenants}"
                             ItemContainerStyle="{StaticResource CoreCovenantFilterChip}"
                             SelectionChanged="OnMultiFilterChanged">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <controls:CovenantIcon Covenant="{Binding}" Width="16" Height="16" Margin="0,0,4,0"
                                        Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" />
                                    <TextBlock Text="{Binding Converter={StaticResource NullToAll}, ConverterParameter=全部}"
                                           FontSize="11" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>

                <!-- Other covenants row -->
                <DockPanel Margin="0,0,0,0">
                    <TextBlock Text="其他" Style="{StaticResource CovenantGroupLabel}" />
                    <ListBox x:Name="OtherCovenantFilterList"
                         controls:FilterChipSelection.IsEnabled="True"
                             Style="{StaticResource FilterChipListBox}"
                             ItemsSource="{Binding AvailableOtherCovenants}"
                             ItemContainerStyle="{StaticResource AdditionalCovenantFilterChip}"
                             SelectionChanged="OnMultiFilterChanged">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <controls:CovenantIcon Covenant="{Binding}" Width="16" Height="16" Margin="0,0,4,0"
                                        Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" />
                                    <TextBlock Text="{Binding Converter={StaticResource NullToAll}, ConverterParameter=全部}"
                                           FontSize="11" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel></StackPanel>
                </Expander>
                <Expander Header="词条" Style="{StaticResource FilterSectionExpander}">
                    <StackPanel><ListBox x:Name="TraitFilterList"
                         controls:FilterChipSelection.IsEnabled="True"
                         Style="{StaticResource FilterChipListBox}"
                         ItemsSource="{Binding AvailableTraitTypes}"
                         SelectionChanged="OnMultiFilterChanged">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Converter={StaticResource NullToAll}, ConverterParameter=全部}"
                                       FontSize="11" />
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox></StackPanel>
                </Expander>
                <Expander Header="叠层" Style="{StaticResource FilterSectionExpander}">
                    <StackPanel><ListBox x:Name="StackingFilterList"
                         Style="{StaticResource FilterChipListBox}"
                         SelectionChanged="OnStackingFilterChanged">
                    <ListBoxItem Content="全部" />
                    <ListBoxItem Content="叠层" />
                    <ListBoxItem Content="非叠层" />
                </ListBox></StackPanel>
                </Expander>
                <Expander Header="触发时机" Style="{StaticResource FilterSectionExpander}">
                    <StackPanel><ListBox x:Name="TriggerTimingFilterList"
                         controls:FilterChipSelection.IsEnabled="True"
                         Style="{StaticResource FilterChipListBox}"
                         ItemsSource="{Binding AvailableTriggerTimings}"
                         SelectionChanged="OnMultiFilterChanged">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Converter={StaticResource NullToAll}, ConverterParameter=全部}"
                                       FontSize="11" />
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox></StackPanel>
                </Expander>
            </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- Operator list (virtualized: ScrollViewer lives inside the template so WPF can recycle cards) -->
        <ItemsControl x:Name="OperatorListControl" ItemsSource="{Binding FilteredOperators}"
                      VirtualizingPanel.IsVirtualizing="True"
                      VirtualizingPanel.VirtualizationMode="Recycling"
                      VirtualizingPanel.ScrollUnit="Pixel">
            <ItemsControl.Template>
                <ControlTemplate TargetType="ItemsControl">
                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  CanContentScroll="True"
                                  Focusable="False">
                        <ItemsPresenter Margin="8,0,8,8" />
                    </ScrollViewer>
                </ControlTemplate>
            </ItemsControl.Template>
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <VirtualizingStackPanel />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <controls:OperatorCard TrackingToggled="OnOperatorTrackingToggled"
                                          CovenantAvailability="{Binding DataContext.CovenantAvailability, RelativeSource={RelativeSource AncestorType=views:OperatorBrowseView}}"
                                          controls:OperatorCard.BanToggled="OnOperatorBanToggled" />
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </DockPanel>
</UserControl>
