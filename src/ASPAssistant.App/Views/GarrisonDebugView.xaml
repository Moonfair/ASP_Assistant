<UserControl x:Class="ASPAssistant.App.Views.GarrisonDebugView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../Resources/Styles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <Style TargetType="TextBlock">
                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                <Setter Property="TextWrapping" Value="Wrap"/>
                <Setter Property="Typography.NumeralAlignment" Value="Tabular"/>
            </Style>
            <Style x:Key="Section" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                <Setter Property="Margin" Value="0,14,0,3"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>
    <ScrollViewer x:Name="DebugScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="10,10,10,14">
            <TextBlock x:Name="FeedStatus" Text="等待官方 PC 客户端" AutomationProperties.LiveSetting="Polite"/>
            <Button x:Name="ConnectButton" Style="{StaticResource TrackingButton}" HorizontalAlignment="Left"
                    Visibility="Collapsed" Click="OnConnect" Margin="0,6,0,0" Padding="9,4"/>
            <Grid Margin="0,12,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.3*"/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                <TextBlock Text="来源" Foreground="{StaticResource TextSecondaryBrush}"/>
                <TextBlock Grid.Column="1" Text="回合"/><TextBlock Grid.Column="2" Text="商店等级"/><TextBlock Grid.Column="3" Text="金币"/>
                <TextBlock Grid.Row="1" Text="内存"/><TextBlock Grid.Row="1" Grid.Column="1" x:Name="RoundValue" Text="—"/>
                <TextBlock Grid.Row="1" Grid.Column="2" x:Name="LevelValue" Text="—"/><TextBlock Grid.Row="1" Grid.Column="3" x:Name="CoinValue" Text="—"/>
                <TextBlock Grid.Row="2" Text="画面 OCR"/>
                <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding ScreenHud.Round, TargetNullValue=—, FallbackValue=—}"/>
                <TextBlock Grid.Row="2" Grid.Column="2" Text="{Binding ScreenHud.ShopLevel, TargetNullValue=—, FallbackValue=—}"/>
                <TextBlock Grid.Row="2" Grid.Column="3" Text="{Binding ScreenHud.Gold, TargetNullValue=—, FallbackValue=—}"/>
            </Grid>
            <TextBlock x:Name="PlayerDetails" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,0"/>
            <Expander Header="队友（多人）" Style="{StaticResource FilterSectionExpander}" Margin="0,10,0,0" IsExpanded="True">
                <TextBlock x:Name="Teammates" Text="尚未读取" Margin="2,4,2,6"/>
            </Expander>
            <TextBlock Text="持有干员" Style="{StaticResource Section}"/>
            <TextBlock x:Name="Characters" Text="尚未读取"/>
            <TextBlock Text="持有装备" Style="{StaticResource Section}"/>
            <TextBlock x:Name="Equipment" Text="尚未读取"/>
            <TextBlock Text="道具" Style="{StaticResource Section}"/>
            <TextBlock x:Name="Magic" Text="尚未读取"/>
            <TextBlock Text="商店商品" Style="{StaticResource Section}"/>
            <TextBlock x:Name="Shop" Text="尚未读取"/>
            <TextBlock Text="位置记录" Style="{StaticResource Section}"/>
            <TextBlock x:Name="Positions" Text="尚未读取"/>
            <TextBlock Text="战斗时钟" Style="{StaticResource Section}"/>
            <TextBlock x:Name="Clock" Text="尚未读取"/>
        </StackPanel>
    </ScrollViewer>
</UserControl>
