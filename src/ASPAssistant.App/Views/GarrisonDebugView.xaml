<UserControl x:Class="ASPAssistant.App.Views.GarrisonDebugView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource PanelBackgroundBrush}">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../Resources/Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <Style TargetType="TextBlock">
                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
                <Setter Property="TextWrapping" Value="Wrap" />
                <Setter Property="Typography.NumeralAlignment" Value="Tabular" />
            </Style>
            <Style x:Key="TableCaption" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
                <Setter Property="FontSize" Value="11" />
                <Setter Property="TextAlignment" Value="Right" />
            </Style>
            <Style x:Key="Reading" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                <Setter Property="TextAlignment" Value="Right" />
                <Setter Property="FontWeight" Value="SemiBold" />
            </Style>
            <Style x:Key="DiagnosticGroup" TargetType="Expander" BasedOn="{StaticResource FilterSectionExpander}">
                <Setter Property="IsExpanded" Value="False" />
                <Setter Property="Margin" Value="0" />
            </Style>
            <Style x:Key="DetailLabel" TargetType="TextBlock" BasedOn="{StaticResource SidebarSectionLabel}">
                <Setter Property="Margin" Value="0,0,0,2" />
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <TextBlock x:Name="PageHeading" Text="采集调试" Style="{StaticResource SidebarPageTitle}" Margin="0,0,0,8" />
        <ScrollViewer x:Name="DebugScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
                <Border Style="{StaticResource SidebarSurface}">
                    <StackPanel>
                        <TextBlock Text="来源对照" Style="{StaticResource SidebarSectionLabel}" />
                        <TextBlock x:Name="FeedStatus" Text="等待官方 PC 客户端" Margin="0,4,0,0" AutomationProperties.LiveSetting="Polite" />
                        <Button x:Name="ConnectButton" Style="{StaticResource TrackingButton}" HorizontalAlignment="Left"
                                Visibility="Collapsed" Click="OnConnect" Margin="0,6,0,0" Padding="9,4" />
                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.2*" />
                                <ColumnDefinition Width=".8*" />
                                <ColumnDefinition Width="1.2*" />
                                <ColumnDefinition Width=".8*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Text="来源" TextAlignment="Left" Style="{StaticResource TableCaption}" />
                            <TextBlock Grid.Column="1" Text="回合" Style="{StaticResource TableCaption}" />
                            <TextBlock Grid.Column="2" Text="商店等级" Style="{StaticResource TableCaption}" />
                            <TextBlock Grid.Column="3" Text="金币" Style="{StaticResource TableCaption}" />
                            <Border Grid.Row="1" Grid.ColumnSpan="4" BorderThickness="0,0,0,1" Margin="0,4,0,4" BorderBrush="{StaticResource BorderBrush}" />
                            <TextBlock Grid.Row="2" Text="内存" />
                            <TextBlock Grid.Row="2" Grid.Column="1" x:Name="RoundValue" Text="—" Style="{StaticResource Reading}" />
                            <TextBlock Grid.Row="2" Grid.Column="2" x:Name="LevelValue" Text="—" Style="{StaticResource Reading}" />
                            <TextBlock Grid.Row="2" Grid.Column="3" x:Name="CoinValue" Text="—" Style="{StaticResource Reading}" />
                            <TextBlock Grid.Row="3" Text="画面 OCR" Margin="0,3,0,0" />
                            <TextBlock Grid.Row="3" Grid.Column="1" Margin="0,3,0,0" Style="{StaticResource Reading}"
                                       Text="{Binding ScreenHud.Round, TargetNullValue=—, FallbackValue=—}" />
                            <TextBlock Grid.Row="3" Grid.Column="2" Margin="0,3,0,0" Style="{StaticResource Reading}"
                                       Text="{Binding ScreenHud.ShopLevel, TargetNullValue=—, FallbackValue=—}" />
                            <TextBlock Grid.Row="3" Grid.Column="3" Margin="0,3,0,0" Style="{StaticResource Reading}"
                                       Text="{Binding ScreenHud.Gold, TargetNullValue=—, FallbackValue=—}" />
                        </Grid>
                        <TextBlock x:Name="PlayerDetails">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                    <Setter Property="Margin" Value="0,6,0,0" />
                                    <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
                                    <Style.Triggers>
                                        <Trigger Property="Text" Value=""><Setter Property="Visibility" Value="Collapsed" /></Trigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </Border>
                <TextBlock Text="诊断明细" Style="{StaticResource SidebarSectionLabel}" Margin="0,12,0,2" />
                <Expander Header="队友（多人）" Style="{StaticResource DiagnosticGroup}">
                    <TextBlock x:Name="Teammates" Text="尚未读取" Margin="0,0,0,6" />
                </Expander>
                <Expander Header="持有干员、装备与道具" Style="{StaticResource DiagnosticGroup}">
                    <StackPanel Margin="0,0,0,6">
                        <TextBlock Text="持有干员" Style="{StaticResource DetailLabel}" />
                        <TextBlock x:Name="Characters" Text="尚未读取" Margin="0,0,0,8" />
                        <TextBlock Text="持有装备" Style="{StaticResource DetailLabel}" />
                        <TextBlock x:Name="Equipment" Text="尚未读取" Margin="0,0,0,8" />
                        <TextBlock Text="道具" Style="{StaticResource DetailLabel}" />
                        <TextBlock x:Name="Magic" Text="尚未读取" />
                    </StackPanel>
                </Expander>
                <Expander Header="商店商品" Style="{StaticResource DiagnosticGroup}">
                    <TextBlock x:Name="Shop" Text="尚未读取" Margin="0,0,0,6" />
                </Expander>
                <Expander Header="位置记录与战斗时钟" Style="{StaticResource DiagnosticGroup}">
                    <StackPanel Margin="0,0,0,6">
                        <TextBlock Text="位置记录" Style="{StaticResource DetailLabel}" />
                        <TextBlock x:Name="Positions" Text="尚未读取" Margin="0,0,0,8" />
                        <TextBlock Text="战斗时钟" Style="{StaticResource DetailLabel}" />
                        <TextBlock x:Name="Clock" Text="尚未读取" />
                    </StackPanel>
                </Expander>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
