<UserControl x:Class="ASPAssistant.App.Views.LineupPreviewView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:ASPAssistant.App.Views"
             SizeChanged="OnPreviewSizeChanged">
    <UserControl.Resources>
        <ResourceDictionary Source="../Resources/LineupStyles.xaml" />
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition />
        </Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,12">
            <TextBlock x:Name="LineupTitle" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap" />
            <TextBlock x:Name="AuthorLabel" Foreground="{StaticResource AccentBrush}" TextWrapping="Wrap" Margin="0,4,0,0" />
            <TextBlock x:Name="CovenantTags" Foreground="{StaticResource AccentBrush}" TextWrapping="Wrap" />
        </StackPanel>
        <ScrollViewer Grid.Row="1" MaxHeight="140" Margin="0,0,0,8"
                      VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <views:LineupMemberStrip x:Name="MemberStrip" />
        </ScrollViewer>
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition />
                <ColumnDefinition x:Name="DiagramColumn" Width="0" />
            </Grid.ColumnDefinitions>
            <Border Background="#FF12122A" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                <FlowDocumentScrollViewer x:Name="Introduction" VerticalScrollBarVisibility="Auto" IsToolBarVisible="False" />
            </Border>
            <Border x:Name="DiagramPreviewHost" Grid.Column="1" Margin="10,0,0,0" Visibility="Collapsed"
                    Background="#FF12122A" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                <FlowDocumentScrollViewer x:Name="DiagramPreview" VerticalScrollBarVisibility="Auto" IsToolBarVisible="False"
                                          AutomationProperties.Name="流程图" />
            </Border>
        </Grid>
    </Grid>
</UserControl>
