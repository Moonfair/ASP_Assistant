{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "build",
            "command": "dotnet",
            "type": "process",
            "args": [
                "build",
                "${workspaceFolder}/ASPAssistant.sln",
                "/property:GenerateFullPaths=true",
                "/consoleloggerparameters:NoSummary;ForceNoAlign"
            ],
            "problemMatcher": "$msCompile"
        },
        {
            "label": "publish",
            "command": "pwsh",
            "type": "process",
            "args": [
                "-NoProfile", "-File", "${workspaceFolder}/scripts/publish.ps1",
                "-Version", "${input:releaseVersion}"
            ],
            "problemMatcher": "$msCompile"
        },
        {
            "label": "watch",
            "command": "dotnet",
            "type": "process",
            "args": [
                "watch",
                "run",
                "--project",
                "${workspaceFolder}/ASPAssistant.sln"
            ],
            "problemMatcher": "$msCompile"
        }
    ],
    "inputs": [
        {
            "id": "releaseVersion",
            "type": "promptString",
            "description": "安装包版本号（例如 1.2.3）"
        }
    ]
}
