PUBLIC_ORIGIN=https://aspa.moonfair.cn

# disabled、ses 或 smtp。正式启用邮箱登录前选定发信方式。
MAIL_PROVIDER=disabled
# node -p "require('node:crypto').randomBytes(32).toString('base64')"
AUTH_SECRET=
# 可选独立短链密钥（32 字节随机数据，Base64）。未设置时从 AUTH_SECRET 派生。
SHARE_SECRET=

# SES 和 SMTP 都需要发信地址。
MAIL_FROM=

# 腾讯云邮件推送 API。模板正文使用 {{code}}。
SES_REGION=ap-guangzhou
SES_TEMPLATE_ID=
TENCENTCLOUD_SECRET_ID=
TENCENTCLOUD_SECRET_KEY=

# SMTP。465 使用隐式 TLS，587 要求 STARTTLS。
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
