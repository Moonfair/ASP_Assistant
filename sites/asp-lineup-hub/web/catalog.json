rategy-icons/b85f3c66b7ebb399.png"},"内部货源":{"sponsor":"天空盒","description":"点击使用（消耗0）：下一件购买的装备价格-1（最多减至0）","image":"/strategy-icons/b9708da8f4e29bb2.png"},"纸片替身":{"sponsor":"风丸","description":"拖拽使用（消耗0）：选择一名调度中心内的干员，使其变为相同等阶的随机干员（每回合限2次）","image":"/strategy-icons/f7c23ff5c392094e.png"},"溃心领域":{"sponsor":"妮芙","description":"拖拽使用（消耗0）：选择一个可用地块，战斗开始后首次经过该地块的敌人获得恐惧，持续3秒（每回合限1次）\n第4、8、12回合时升级，增加使用次数","image":"/strategy-icons/0a06506190f5f621.png"},"幻画为真":{"sponsor":"夕","description":"拖拽使用（消耗0）：选择一名我方干员，获得他的复制体，包括精锐状态和携带的装备（每场模拟限1次）","image":"/strategy-icons/d04e5efbbcc1bfed.png"},"条文修正":{"sponsor":"但书","description":"第4回合解锁\n拖拽使用（消耗0）：选择一名我方干员，使该干员已激活的所有盟约层数+9（冷却3回合）","image":"/strategy-icons/0d2460b8fd616337.png"},"全场聚焦":{"sponsor":"大嘴莫布","description":"拖拽使用（消耗1）：选择一名我方干员，下次战斗开始时变为精锐干员，持续至战斗结束","image":"/strategy-icons/d14dffa858627151.png"},"集结指示":{"sponsor":"杰西卡","description":"被动效果：在第4、7、10、13回合进入休整期时获得1个<寻呼模块>\n<寻呼模块>：装备时销毁，在调度中心出现至多3名拥有该干员第一盟约的其他干员，免费获取其中1名（等阶不高于当前调度中心）","image":"/strategy-icons/a4d4526c6c17f78c.png"},"重点监护":{"sponsor":"华法琳","description":"被动效果：战斗开始时，使场上每个不同等阶的1个随机我方干员所属的已激活盟约层数+1\n调度中心等级达到3级、5级时升级使盟约层数额外+1","image":"/strategy-icons/8aff6cee52a8b131.png"},"药枚实验":{"sponsor":"桑葚","description":"拖拽使用（消耗0）：选择一名我方干员，在下次战斗开始时获得效果：每次攻击时有20%的概率获得1层护盾（最多1层）\n第7回合时效果升级","image":"/strategy-icons/f7931b15b05fa109.png"},"全力熔铸":{"sponsor":"奥达","description":"被动效果：在第3、6、9、12、14回合进入休整期时获得1件当前调度中心等级的随机装备","image":"/strategy-icons/049d3e9ebb8cd3e1.png"},"以己之长":{"sponsor":"陈","description":"被动效果：所有干员造成的物理和法术伤害变为弱点伤害（根据敌人的防御力和法术抗性变更伤害类型），精锐干员额外获得攻击力+16%，攻击速度+16","image":"/strategy-icons/94a932c8faa5b2e5.png"},"得闲饮茶":{"sponsor":"老鲤","description":"被动效果：第1、2回合的资金暂存至第3回合发放；第3回合进入休整期时，获得2、4阶随机干员各1名","image":"/strategy-icons/383f1e8087b81a65.png"},"协力共进":{"sponsor":"芬","description":"被动效果：第8、10、12、14回合进入休整期时获得1个<信标>\n<信标>：装备时销毁携带干员，在调度中心出现2名同等阶干员，免费获得其中1名；被销毁干员在下回合传递给对应盟约人数最多的队友","image":"/strategy-icons/a5604ce1e23dcd5f.png"},"外勤医疗":{"sponsor":"Touch","description":"被动效果：所有玩家场上出现一名<预备干员-医疗>；战斗开始时，若场上至少有2名精锐干员，则替换为<Touch>","image":"/strategy-icons/9b36af806ef302f7.png"},"暴躁铁皮":{"sponsor":"森蚺","description":"被动效果：第1回合获得1名可以装备4件装备的特殊干员<“暴躁铁皮”>","image":"/strategy-icons/a7960b6079a1e1ea.png"},"宝藏探机":{"sponsor":"寻宝人","description":"拖拽使用（消耗1）：选择一个可用地块，部署1个<“模拟宝藏”>（冷却3回合）\n<“模拟宝藏”>：被敌人触碰就会永久消失，战斗结束时若仍存在则获得额外1资金","image":"/strategy-icons/c60241815a0cf3f5.png"},"至纯凝结":{"sponsor":"缪尔赛思","description":"拖拽使用（消耗0）：选择一名我方干员，立即使该干员晋升为精锐干员（每场模拟限1次）","image":"/strategy-icons/5fa5bcfe215a5750.png"},"消解空间":{"sponsor":"Misery","description":"拖拽使用（消耗0）：选择一名我方干员，下场战斗开始后首次受到伤害时使其击倒，并召唤整备区最右侧干员","image":"/strategy-icons/09f38b7c1b408c4a.png"},"变形同构":{"sponsor":"“变形者集群”","description":"被动效果：每5回合获得1件特殊装备<变形同构体>\n<变形同构体>：与特定装备一同装备时装备者将视为特定盟约成员","image":"/strategy-icons/e63aa57051e6910f.png"},"私募基金":{"sponsor":"小贾斯汀","description":"点击使用（消耗0）：随机获得1-6资金（冷却回合数等同于获得资金）","image":"/strategy-icons/c88b4c7c28955042.png"},"御守之力":{"sponsor":"铃兰","description":"拖拽使用（消耗0）：选择一名我方干员，触发该干员的<获得时>类特质","image":"/strategy-icons/8c85a9d51bde952e.png"},"强制休整":{"sponsor":"苏苏洛","description":"拖拽使用（消耗0）：选择一名我方干员，使该干员的<休整期结束时>类特质本回合可以额外触发一次","image":"/strategy-icons/97dfec6568042a82.png"},"不稳定要素":{"sponsor":"昆图斯","description":"第4回合解锁\n拖拽使用（消耗0）：选择一名我方干员，立即使其变为更高一阶的随机干员（最高不超过6阶）","image":"/strategy-icons/50508c40ab240df6.png"},"献身护卫":{"sponsor":"信仰搅拌机","description":"第4回合解锁\n点击使用（消耗0）：自身目标生命值降至与场上最低的玩家相同并获得等同损失生命值的资金（至多10资金），在<休整期结束时>为该玩家回复等额目标生命值","image":"/strategy-icons/3ed9addad1c5db0f.png"},"好多委托！":{"sponsor":"“追随者们”","description":"被动效果：每次进入休整期时，从2个随机指令中选择1个并替换当前指令","image":"/strategy-icons/986869995358afaa.png"},"利滚利":{"sponsor":"坎诺特","description":"被动效果：每回合剩余的资金可以继承，剩余至少5资金时，每回合额外获得1资金","image":"/strategy-icons/756cc9b72e244e5e.png"},"“神秘顾客”":{"sponsor":"鸭爵","description":"被动效果：从第5回合起，你和队友遭遇的部分敌人可能会替换为<鸭爵>、<高普尼克>、<流泪小子>、<圆仔>，击倒这些敌人可以获得1资金奖励（包括联防阶段）","image":"/strategy-icons/c5de14256494a2ac.png"},"最佳品味":{"sponsor":"琳琅诗怀雅","description":"消耗资金达到60时解锁\n点击使用（消耗0）：随机获取当前调度中心内的1名干员\n